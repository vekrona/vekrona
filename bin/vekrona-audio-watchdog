#!/usr/bin/env python3
"""Restart WirePlumber when it has stopped reacting to devices, and record that as an error.

WirePlumber runs its policy as a queue of events. An event whose hook is still waiting (for a proxy to bind, for a
device that vanished meanwhile) holds back every event behind it, with no timeout, so one lost completion leaves
the daemon alive and answering `wpctl` while it ignores every later device: cards stay on profile "off" and the
default sink names a device that is gone. The state it is stuck in is visible in the PipeWire graph, so this
service watches the graph (`pw-dump --monitor` prints on every change) and, when that state outlasts GRACE_SEC,
restarts WirePlumber.
"""
import codecs
import json
import os
import select
import subprocess
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import vekrona_cli

PROG = "vekrona-audio-watchdog"
# What WirePlumber remembers per card ("[default-profile]", "device.name=profile"); a card whose stored profile is "off"
# was turned off on purpose, which is not a wedge.
PROFILE_STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                             "wireplumber", "default-profile")
# A hot-plug settles in well under a second; this is several times that.
GRACE_SEC = 5.0
READ_CHUNK = 1 << 16
MAX_PENDING = 1 << 26
# What the problems are made of. The watchdog's own pw-dump calls show up in the monitor as clients that come and go,
# and a change of that kind would wake the watchdog for a snapshot that makes the next one.
RELEVANT_OBJECTS = ("Device", "Node", "Metadata")

DEFAULT_KEYS = {"Audio/Sink": "default.audio.sink", "Audio/Source": "default.audio.source"}
# WirePlumber never picks these for a card: it skips pro-audio on purpose, and off is what it falls back to.
NOT_AUTOMATIC_PROFILES = ("off", "pro-audio")

die = vekrona_cli.make_die(PROG, __file__, report=False)


def log(msg):
    print(f"[{PROG}] {msg}", file=sys.stderr, flush=True)


def default_node_names(objects):
    names = {}
    for obj in objects:
        if obj["type"].endswith(":Metadata") and obj["props"].get("metadata.name") == "default":
            for entry in obj.get("metadata", []):
                value = entry["value"]
                names[entry["key"]] = value.get("name") if isinstance(value, dict) else value
    return names


def stale_defaults(objects):
    """A default that names no node, while nodes of that kind exist, is one WirePlumber should have replaced."""
    nodes = {}
    for obj in objects:
        props = (obj.get("info") or {}).get("props", {})
        if obj["type"].endswith(":Node") and props.get("media.class") in DEFAULT_KEYS:
            nodes.setdefault(props["media.class"], set()).add(props["node.name"])
    defaults = default_node_names(objects)
    problems = []
    for media_class, key in DEFAULT_KEYS.items():
        present = nodes.get(media_class)
        if present and defaults.get(key) not in present:
            problems.append(f"{key} is {defaults.get(key)!r}, which is not among the {len(present)} existing "
                            f"{media_class} nodes ({', '.join(sorted(present))})")
    return problems


def stored_profiles(path=PROFILE_STATE):
    """The profile WirePlumber has stored for each card, by device name; none when it has stored nothing yet."""
    try:
        with open(path) as state:
            lines = state.read().splitlines()
    except FileNotFoundError:
        return {}
    profiles = {}
    in_section = False
    for line in lines:
        if line.startswith("["):
            in_section = line.strip() == "[default-profile]"
        elif in_section and "=" in line:
            name, _, profile = line.partition("=")
            profiles[name] = profile
    return profiles


def cards_left_off(objects, stored=None):
    """An ALSA card on profile "off" while it offers a profile WirePlumber would have chosen for it, unless the
    profile stored for the card is "off": that is somebody's choice, and WirePlumber follows it."""
    stored = stored or {}
    problems = []
    for obj in objects:
        info = obj.get("info") or {}
        props = info.get("props", {})
        if not obj["type"].endswith(":Device") or props.get("device.api") != "alsa":
            continue
        params = info.get("params", {})
        active = [profile["name"] for profile in params.get("Profile", [])]
        usable = [profile["name"] for profile in params.get("EnumProfile", [])
                  if profile["name"] not in NOT_AUTOMATIC_PROFILES and profile.get("available") != "no"]
        if active == ["off"] and usable and stored.get(props["device.name"]) != "off":
            problems.append(f"{props['device.name']} is on profile off although {', '.join(usable)} can be used")
    return problems


def find_problems(objects):
    return stale_defaults(objects) + cards_left_off(objects, stored_profiles())


def snapshot():
    return json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True, check=True, timeout=10).stdout)


def wireplumber_active():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", "wireplumber.service"]).returncode == 0


def report(title, summary):
    reporter = vekrona_cli.resolve_tool(__file__, "vekrona-error")
    if not reporter:
        die("vekrona-error not found, cannot record: " + title)
    subprocess.run([reporter, "report", "--title", title, "--summary", summary, "--source", "vekrona"],
                   check=True, timeout=30)


def restart_wireplumber(problems):
    log("restarting WirePlumber: " + "; ".join(problems))
    subprocess.run(["systemctl", "--user", "restart", "wireplumber.service"], check=True, timeout=30)
    report("WirePlumber stopped reacting to devices and was restarted",
           "WirePlumber showed this for more than %d seconds and was restarted:\n\n%s" % (GRACE_SEC, "\n".join(problems)))


def report_unresolved(problems):
    log("the problem survived the restart: " + "; ".join(problems))
    report("WirePlumber was restarted but still does not follow the devices",
           "After the restart WirePlumber still shows this, so it is not restarted again:\n\n%s" % "\n".join(problems))


class Monitor:
    """The output of `pw-dump --monitor`: JSON documents of the objects that changed, and `null` info for a removed one."""

    def __init__(self, fd):
        self.fd = fd
        self.pending = ""
        self.types = {}
        self.decoder = json.JSONDecoder()
        self.utf8 = codecs.getincrementaldecoder("utf-8")()

    def read(self):
        """Reads what the monitor printed so far, a burst of changes included. Returns (alive, relevant): whether the
        monitor still runs, and whether a device, node or metadata object changed."""
        relevant = False
        while True:
            chunk = os.read(self.fd, READ_CHUNK)
            if not chunk:
                return False, relevant
            self.pending += self.utf8.decode(chunk)
            relevant |= self._parse()
            if not select.select([self.fd], [], [], 0)[0]:
                return True, relevant

    def _parse(self):
        relevant = False
        while True:
            self.pending = self.pending.lstrip()
            if not self.pending:
                return relevant
            try:
                document, end = self.decoder.raw_decode(self.pending)
            except json.JSONDecodeError:
                if len(self.pending) > MAX_PENDING:
                    die("pw-dump --monitor printed %d bytes that are no JSON document" % len(self.pending))
                return relevant
            self.pending = self.pending[end:]
            for obj in document:
                relevant |= self._note(obj)

    def _note(self, obj):
        kind = obj.get("type")
        if kind is None:
            kind = self.types.pop(obj["id"], None)
        else:
            self.types[obj["id"]] = kind
        return kind is not None and kind.rsplit(":", 1)[-1] in RELEVANT_OBJECTS


def watch(monitor_fd):
    """Wait for graph changes and act when a problem outlasts the grace time: one restart, then one report, per problem."""
    monitor = Monitor(monitor_fd)
    problem_since = None
    restart_available = True
    unresolved_reported = False
    while True:
        timeout = None if problem_since is None else max(0.0, problem_since + GRACE_SEC - time.monotonic())
        ready, _, _ = select.select([monitor_fd], [], [], timeout)
        if ready:
            alive, relevant = monitor.read()
            if not alive:
                die("pw-dump --monitor ended; PipeWire is gone")
            if not relevant:
                continue
        # A WirePlumber that is stopped or still starting is systemd's business, not a wedge.
        problems = find_problems(snapshot()) if wireplumber_active() else []
        if not problems:
            problem_since = None
            restart_available = True
            unresolved_reported = False
        elif problem_since is None:
            if restart_available or not unresolved_reported:
                problem_since = time.monotonic()
        elif time.monotonic() - problem_since >= GRACE_SEC:
            if restart_available:
                restart_wireplumber(problems)
                restart_available = False
            else:
                report_unresolved(problems)
                unresolved_reported = True
            problem_since = None


def main():
    vekrona_cli.require_run_verb(PROG, __doc__)
    monitor = subprocess.Popen(["pw-dump", "--monitor"], stdout=subprocess.PIPE, stderr=sys.stderr)
    watch(monitor.stdout.fileno())


if __name__ == "__main__":
    main()
