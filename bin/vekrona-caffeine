#!/usr/bin/env bash
set -euo pipefail

UNIT_NAME="vekrona-caffeine"
UNIT="$UNIT_NAME.service"

usage() {
  printf 'usage: %s [30m|1h|2h|off|status]\n' "$(basename "$0")" >&2
  exit 1
}

seconds_for() {
  case "$1" in
    30m) echo 1800 ;;
    1h) echo 3600 ;;
    2h) echo 7200 ;;
    *) usage ;;
  esac
}

unit_active() { systemctl --user is-active --quiet "$UNIT"; }

start_caffeine() {
  local dur="$1"
  local secs
  secs="$(seconds_for "$dur")"
  if unit_active; then
    systemctl --user stop "$UNIT"
  fi
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1 || true
  systemd-run --user --collect --unit="$UNIT_NAME" --description="caffeine $dur" \
    systemd-inhibit --what=sleep --who=vekrona --why="caffeine $dur" sleep "$secs"
  notify-send -a vekrona "Caffeine" "suspend inhibited for $dur"
  echo "caffeine: on for $dur"
}

stop_caffeine() {
  if unit_active; then
    systemctl --user stop "$UNIT"
    notify-send -a vekrona "Caffeine" "suspend inhibitor stopped"
    echo "caffeine: off"
  else
    echo "caffeine: off (was not running)"
  fi
}

status_caffeine() {
  if unit_active; then
    local desc
    desc="$(systemctl --user show "$UNIT" -p Description --value)"
    echo "caffeine: on ($desc)"
  else
    echo "caffeine: off"
  fi
}

cmd="${1:-}"

case "$cmd" in
  off)
    stop_caffeine
    ;;
  status)
    status_caffeine
    ;;
  30m|1h|2h)
    start_caffeine "$cmd"
    ;;
  "")
    if unit_active; then
      stop_caffeine
    else
      start_caffeine 1h
    fi
    ;;
  *)
    usage
    ;;
esac
