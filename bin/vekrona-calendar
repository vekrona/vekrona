#!/usr/bin/env bash
set -euo pipefail

PROG="$(basename "$0")"
HORIZON=31d
CALENDAR_ROOT="$HOME/.local/share/vekrona-calendars"
VDIRSYNCER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/vdirsyncer/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/vekrona"

usage() {
  printf 'usage: %s sync|render|configured\n' "$PROG" >&2
  exit 1
}

fail() {
  printf '%s: %s\n' "$PROG" "$*" >&2
  exit 1
}

events_json() {
  if [[ -z "$(find "$CALENDAR_ROOT" -mindepth 1 -maxdepth 1 -type d -print -quit)" ]]; then
    echo '[]'
    return
  fi
  khal list --json title --json start --json end --json all-day --json location --json calendar \
    --day-format '' today "$HORIZON" |
    jq -s 'add // [] | map(. + {allDay: (.["all-day"] == "True")} | del(.["all-day"])) | unique_by([.start, .end, .title, .calendar]) | sort_by(.start)'
}

render() {
  mkdir -p "$CALENDAR_ROOT" "$STATE_DIR"
  local ready=false events temp
  is_configured && ready=true
  events="$(events_json)"
  temp="$(mktemp "$STATE_DIR/.calendar.XXXXXX")"
  if ! jq -n --argjson configured "$ready" --argjson events "$events" \
    '{configured: $configured, events: $events}' >"$temp"; then
    rm -f "$temp"
    fail "cannot write the calendar"
  fi
  mv "$temp" "$STATE_DIR/calendar.json"
}

redact_urls() {
  sed -E 's#(https?://)[^/@[:space:]"]*@#\1#g; s#(https?://[^/[:space:]"]+)[^[:space:]"]*#\1/<redacted>#g'
}

# The storages of the vdirsyncer config that still hold a PLACEHOLDER, space-separated. Commented lines do not count.
placeholder_storages() {
  [[ -f "$VDIRSYNCER_CONFIG" ]] || return 0
  awk '
    /^[[:space:]]*\[/ { name = ""; if (match($0, /\[storage [^]]+\]/)) name = substr($0, RSTART + 9, RLENGTH - 10) }
    name != "" && !/^[[:space:]]*#/ && /PLACEHOLDER/ && !seen[name]++ { printf "%s ", name }
  ' "$VDIRSYNCER_CONFIG"
}

# The one definition of "configured": a vdirsyncer config exists and no storage in it is still a placeholder.
is_configured() {
  [[ -f "$VDIRSYNCER_CONFIG" && -z "$(placeholder_storages)" ]]
}

# The unit's ExecCondition. Exit 0 runs the sync. Exit 1 skips it without failing the unit: an unconfigured calendar
# is not an error, the popout says so. systemd treats 255 as a failure, so a render that breaks must not exit 1.
configured() {
  is_configured && exit 0
  trap 'exit 255' EXIT
  render
  trap - EXIT
  exit 1
}

sync() {
  local status=0 output placeholders
  if ! is_configured; then
    render
    placeholders="$(placeholder_storages)"
    if [[ -n "$placeholders" ]]; then
      fail "fill in or delete the placeholder storages in $VDIRSYNCER_CONFIG: ${placeholders% } (see docs/calendar.md)"
    fi
    fail "no $VDIRSYNCER_CONFIG yet (see docs/calendar.md)"
  fi
  output="$(mktemp)"
  { vdirsyncer metasync && vdirsyncer sync; } >"$output" 2>&1 || status=$?
  redact_urls <"$output" >&2
  if ((status != 0)) && grep -q 'vdirsyncer discover' "$output"; then
    # shellcheck disable=SC2016 # the backticks are literal: they quote the command for the user
    printf '%s: run `vdirsyncer discover` once by hand, then start vekrona-calendar.service again\n' "$PROG" >&2
  fi
  rm -f "$output"
  render
  exit "$status"
}

[[ $# -eq 1 ]] || usage
case "$1" in
  render) render ;;
  sync) sync ;;
  configured) configured ;;
  *) usage ;;
esac
