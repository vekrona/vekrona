#!/usr/bin/env bash
set -euo pipefail

PROG="$(basename "$0")"
HORIZON=31d
CALENDAR_ROOT="$HOME/.local/share/vekrona-calendars"
VDIRSYNCER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/vdirsyncer/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/vekrona"

usage() {
  printf 'usage: %s sync|render|configured\n' "$PROG" >&2
  exit 1
}

fail() {
  printf '%s: %s\n' "$PROG" "$*" >&2
  exit 1
}

events_json() {
  if [[ -z "$(find "$CALENDAR_ROOT" -mindepth 1 -maxdepth 1 -type d -print -quit)" ]]; then
    echo '[]'
    return
  fi
  # -v ERROR: khal warns on every Proton event whose end equals its start ("Assuming the event's duration is one
  # hour"), hundreds of lines per run. Errors still print.
  khal -v ERROR list --json title --json start --json end --json all-day --json location --json calendar \
    --day-format '' today "$HORIZON" |
    jq -s 'add // [] | map(. + {allDay: (.["all-day"] == "True")} | del(.["all-day"])) | unique_by([.start, .end, .title, .calendar]) | sort_by(.start)'
}

render() {
  mkdir -p "$CALENDAR_ROOT" "$STATE_DIR"
  local ready=false events pairs temp
  pairs="$(ready_pairs)"
  [[ -z "$pairs" ]] || ready=true
  events="$(events_json)"
  temp="$(mktemp "$STATE_DIR/.calendar.XXXXXX")"
  if ! jq -n --argjson configured "$ready" --argjson events "$events" \
    '{configured: $configured, events: $events}' >"$temp"; then
    rm -f "$temp"
    fail "cannot write the calendar"
  fi
  mv "$temp" "$STATE_DIR/calendar.json"
}

redact_urls() {
  sed -E 's#(https?://)[^/@[:space:]"]*@#\1#g; s#(https?://[^/[:space:]"]+)[^[:space:]"]*#\1/<redacted>#g'
}

# The one definition of "configured": the names of the pairs of the vdirsyncer config that are ready to sync, one per
# line. A pair is ready when neither of its storages (`a`, `b`) holds a PLACEHOLDER; the template ships one pair per
# provider and nobody fills in all of them, so the pairs that are still placeholders are skipped silently. Commented
# lines do not count. A pair that names a storage the config does not define is an error.
ready_pairs() {
  [[ -f "$VDIRSYNCER_CONFIG" ]] || return 0
  awk -v prog="$PROG" -v config="$VDIRSYNCER_CONFIG" '
    function die(message) {
      printf "%s: %s\n", prog, message > "/dev/stderr"
      exit 1
    }
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*\[/ {
      kind = ""
      name = ""
      if (match($0, /\[(pair|storage) [^]]+\]/)) {
        split(substr($0, RSTART + 1, RLENGTH - 2), words, " ")
        kind = words[1]
        name = words[2]
        if (kind == "pair") pairs[++pair_count] = name
        else defined[name] = 1
      }
      next
    }
    kind == "pair" && match($0, /^[[:space:]]*[ab][[:space:]]*=[[:space:]]*"[^"]*"/) {
      side = $0
      sub(/^[[:space:]]*/, "", side)
      side = substr(side, 1, 1)
      value = substr($0, RSTART, RLENGTH)
      sub(/^[^"]*"/, "", value)
      sub(/"$/, "", value)
      storage[name, side] = value
    }
    kind == "storage" && /PLACEHOLDER/ { placeholder[name] = 1 }
    END {
      for (i = 1; i <= pair_count; i++) {
        pair = pairs[i]
        ready = 1
        for (side_index = 1; side_index <= 2; side_index++) {
          side = (side_index == 1) ? "a" : "b"
          wanted = storage[pair, side]
          if (wanted == "") die("pair " pair " in " config " has no " side " storage")
          if (!(wanted in defined)) die("pair " pair " in " config " uses the storage " wanted ", which the config does not define")
          if (wanted in placeholder) ready = 0
        }
        if (ready) print pair
      }
    }
  ' "$VDIRSYNCER_CONFIG"
}

# The unit's ExecCondition. Exit 0 runs the sync. Exit 1 skips it without failing the unit: an unconfigured calendar
# is not an error, the popout says so. systemd treats 255 as a failure, so a broken config or render must not exit 1.
configured() {
  local pairs
  trap 'exit 255' EXIT
  pairs="$(ready_pairs)"
  if [[ -n "$pairs" ]]; then
    trap - EXIT
    exit 0
  fi
  render
  trap - EXIT
  exit 1
}

sync() {
  local status=0 output pairs report
  pairs="$(ready_pairs)"
  if [[ -z "$pairs" ]]; then
    render
    if [[ -f "$VDIRSYNCER_CONFIG" ]]; then
      fail "no pair in $VDIRSYNCER_CONFIG is filled in yet: replace the PLACEHOLDERs of one provider (see docs/calendar.md)"
    fi
    fail "no $VDIRSYNCER_CONFIG yet (see docs/calendar.md)"
  fi
  local -a ready
  mapfile -t ready <<<"$pairs"
  output="$(mktemp)"
  # -v WARNING: without it vdirsyncer logs a line per copied item on the first sync, and nobody reads them.
  { vdirsyncer -v WARNING metasync "${ready[@]}" && vdirsyncer -v WARNING sync "${ready[@]}"; } >"$output" 2>&1 || status=$?
  # Print from this process, not from sed: a writer that exits before journald looks it up is logged without
  # _SYSTEMD_USER_UNIT, so `journalctl --user -u vekrona-calendar.service` would not show the failure reason.
  report="$(redact_urls <"$output")"
  [[ -z "$report" ]] || printf '%s\n' "$report" >&2
  rm -f "$output"
  render
  exit "$status"
}

[[ $# -eq 1 ]] || usage
case "$1" in
  render) render ;;
  sync) sync ;;
  configured) configured ;;
  *) usage ;;
esac
