#!/usr/bin/env bash
# The single entry point for locking the screen. The sway bindings, the power
# menu and swayidle (idle timeout, before-sleep and logind's lock event) run
# it. One Quickshell process per lock, kept by vekrona-lock.service: it exits
# on unlock, and a crashed locker restarts and locks again. The unit is
# Type=notify and the locker says READY once the compositor confirmed the lock,
# so this returns only when the screen is locked (swayidle's before-sleep waits
# for that) and fails when it cannot be. Starting is idempotent: a concurrent
# caller joins the start in progress, so no check precedes it.
set -euo pipefail
shopt -s inherit_errexit

PROG="vekrona-lock"
UNIT="vekrona-lock.service"

if ! err="$(systemctl --user start "$UNIT" 2>&1)"; then
  printf '%s: %s\n' "$PROG" "$err" >&2
  notify-send -u critical -a vekrona "$PROG" "Cannot start the lock screen: $err" || printf '%s: notify-send failed\n' "$PROG" >&2
  exit 1
fi
