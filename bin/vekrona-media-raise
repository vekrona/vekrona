#!/usr/bin/env bash
# Focuses the window of an MPRIS player. MPRIS Raise needs an activation token that players such as
# Firefox lack on Sway, so this finds the window by process instead: the process that owns the bus name,
# or its nearest ancestor with a window (a terminal running mpv or cmus).
set -euo pipefail

usage() {
  printf 'usage: %s <mpris-bus-name>\n' "$(basename "$0")" >&2
  exit 2
}

fail() {
  printf 'vekrona-media-raise: %s\n' "$*" >&2
  exit 1
}

[[ $# -eq 1 && -n "$1" ]] || usage
name="$1"

reply="$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus GetConnectionUnixProcessID s "$name")" \
  || fail "cannot ask the bus which process owns $name"
owner="${reply#u }"
[[ "$owner" =~ ^[0-9]+$ ]] || fail "unexpected reply for $name: $reply"

# The parent of pid, read after the last ')' of /proc/<pid>/stat, because the command name may contain spaces and parentheses.
parent_of() {
  local stat fields
  stat="$(<"/proc/$1/stat")" || return 1
  read -ra fields <<<"${stat##*) }"
  printf '%s\n' "${fields[1]}"
}

pid="$owner"
while ((pid > 1)); do
  if out="$(swaymsg "[pid=$pid] focus" 2>&1)"; then
    exit 0
  fi
  [[ "$out" == *"No matching node"* ]] || fail "swaymsg failed: $out"
  parent="$(parent_of "$pid")" || fail "cannot read the parent of process $pid"
  pid="$parent"
done

fail "no window belongs to $name (pid $owner) or its ancestors"
