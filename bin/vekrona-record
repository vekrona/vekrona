#!/usr/bin/env bash
set -euo pipefail

UNIT_NAME="vekrona-record"
UNIT="$UNIT_NAME.service"
DEST_DIR="$HOME/Videos/Recordings"

if systemctl --user is-active --quiet "$UNIT"; then
  systemctl --user kill --signal=SIGINT "$UNIT"
  notify-send -a vekrona "Recording" "stopped, saved under $DEST_DIR"
else
  mkdir -p "$DEST_DIR"
  FILE="$DEST_DIR/$(date +%Y%m%d-%H%M%S).mp4"

  geometry="$(slurp)" || { echo "vekrona-record: selection cancelled" >&2; exit 1; }
  [[ -n "$geometry" ]] || { echo "vekrona-record: selection cancelled" >&2; exit 1; }

  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1 || true
  systemd-run --user --collect --unit="$UNIT_NAME" wf-recorder -g "$geometry" -f "$FILE"

  if systemctl --user is-active --quiet "$UNIT"; then
    notify-send -a vekrona "Recording" "started, will save to $FILE"
    echo "recording: started, $FILE"
  else
    echo "vekrona-record: wf-recorder failed to start" >&2
    journalctl --user -u "$UNIT_NAME" -n 5 >&2 || true
    exit 1
  fi
fi
