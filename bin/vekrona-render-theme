# The webapp window has no browser chrome: its toolbars collapse (this is what the former per-app
# config/firefox/webapps/<app>/userChrome.css files held).
WEBAPP_CHROME = """
#nav-bar,
#TabsToolbar,
#PersonalToolbar {
  visibility: collapse !important;
}
"""


def render_user_chrome(theme, mode, design):
    return USER_CHROME.substitute(theme.colors[mode], r=design["radius"])


def apply_firefox(theme, mode, design, explicit):
    profiles = read_profiles_ini()
    default = find_default_profile(*profiles) if profiles else None
    webapps = find_webapp_profiles(*profiles) if profiles else []
    if default is None and not webapps:
        if explicit:
            die(f"no Firefox profile to theme under {firefox_profile_root()} "
                "(start Firefox once, or install a vekrona webapp, then retry)")
        print(f"{PROG}: no Firefox profile yet, skipping the firefox target "
              "(run vekrona-render-theme firefox after Firefox has started once)", file=sys.stderr)
        return
    if default is None:
        print(f"{PROG}: no default Firefox profile yet, theming only the vekrona webapp profiles "
              "(run vekrona-render-theme firefox after Firefox has started once)", file=sys.stderr)
    for profile in [p for p in [default, *webapps] if p]:
        if not os.path.isdir(profile):
            die(f"Firefox profile directory does not exist: {profile}")
    chrome = render_user_chrome(theme, mode, design)
    files = {}
    if default:
        files[os.path.join(default, "user.js")] = ("slash", render_user_js(mode))
        files[os.path.join(default, "chrome", "userChrome.css")] = ("css", chrome)
    for profile in webapps:
        files[os.path.join(profile, "chrome", "userChrome.css")] = ("css", chrome + WEBAPP_CHROME)
    write_and_report(files)


# ---------------------------------------------------------------- sway

SWAY_DESIGN_CONF = home_path(".config", "sway", "config.d", "90-vekrona-design.conf")


def render_sway(theme, mode):
    c = theme.colors[mode]
    inactive = f"{c['line']} {c['surface-1']} {c['ink-muted']} {c['line']} {c['line']}"
    body = f"""font pango:{font_spec(theme.sans(), theme.type_px('body'))}
default_border pixel 1
default_floating_border pixel 1
gaps inner {theme.metrics['spacing']['space2']}
output * bg {c['bg']} solid_color
client.focused {c['accent']} {c['accent']} {c['on-accent']} {c['accent']} {c['accent']}
client.focused_inactive {inactive}
client.unfocused {inactive}
client.urgent {c['danger']} {c['danger']} {c['on-danger']} {c['danger']} {c['danger']}
"""
    return {SWAY_DESIGN_CONF: ("hash", body)}


def apply_sway(theme, mode):
    changed = write_and_report(render_sway(theme, mode))
    if changed and os.environ.get("SWAYSOCK"):
        run_or_die(["swaymsg", "reload"], "swaymsg reload")


# ---------------------------------------------------------------- rofi

def render_rofi(theme, mode, design):
    c = theme.colors[mode]
    space = theme.metrics["spacing"]
    r = design["radius"]
    return f"""
* {{
    font: "{font_spec(theme.mono(), theme.type_px('mono'))}";
    background: {c['bg']};
    foreground: {c['ink']};
    lightbg: {c['surface-1']};
    lightfg: {c['ink']};
    border-color: {c['line-strong']};
    separatorcolor: {c['line']};
    normal-background: {c['bg']};
    normal-foreground: {c['ink']};
    alternate-normal-background: {c['surface-1']};
    alternate-normal-foreground: {c['ink']};
    selected-normal-background: transparent;
    selected-normal-foreground: {c['ink']};
    active-background: {c['bg']};
    active-foreground: {c['accent-ink']};
    alternate-active-background: {c['surface-1']};
    alternate-active-foreground: {c['accent-ink']};
    selected-active-background: transparent;
    selected-active-foreground: {c['accent-ink']};
    urgent-background: {c['bg']};
    urgent-foreground: {c['danger-ink']};
    alternate-urgent-background: {c['surface-1']};
    alternate-urgent-foreground: {c['danger-ink']};
    selected-urgent-background: transparent;
    selected-urgent-foreground: {c['danger-ink']};
}}
window {{
    border: 1px;
    border-radius: {r}px;
    padding: {space['space3']}px;
    width: 60%;
}}
element {{
    border-radius: {r}px;
    padding: {space['space1']}px {space['space3']}px;
}}
element selected.normal, element selected.active, element selected.urgent {{
    border: 0 0 2px;
    border-color: {c['accent']};
}}
inputbar {{
    padding: {space['space3']}px;
}}
listview {{
    lines: 18;
    spacing: {space['space1']}px;
}}
mainbox {{
    spacing: {space['space2']}px;
}}
"""


# ---------------------------------------------------------------- main

def main():
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Render the vekrona design tokens (config/tokens.json, config/design.json) in the mode "
                    "of the 'theme' state file into the DMS theme file, GTK, Qt, Firefox and Sway config. "
                    "'all' is dms, gtk, qt, firefox, sway; 'rofi' prints a theme string to stdout and "
                    "writes nothing. Running apps keep old looks until restarted.")
    parser.add_argument("target", nargs="?", default="all", choices=("all",) + ALL_TARGETS)
    target = parser.parse_args().target

    mode = load_mode()
    theme = load_tokens()
    design = load_design()
    if target == "rofi":
        print(render_rofi(theme, mode, design))
        return
    for name in TARGETS if target == "all" else (target,):
        if name == "dms":
            apply_dms(theme, mode)
        elif name == "gtk":
            apply_gtk(theme, mode, design)
        elif name == "qt":
            write_and_report(render_qt(theme, mode))
        elif name == "firefox":
            apply_firefox(theme, mode, design, explicit=target == "firefox")
        else:
            apply_sway(theme, mode)


if __name__ == "__main__":
    main()
