#!/usr/bin/env python3
import argparse
import configparser
import json
import os
import string
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import vekrona_cli
import vekrona_theme

PROG = "vekrona-render-theme"
TARGETS = ("dms", "gtk", "qt", "firefox", "sway")
ALL_TARGETS = TARGETS + ("rofi",)
DESIGN_INT_KEYS = ("radius", "widgetPadding", "trayIconSpacing", "barInnerPadding")
DESIGN_KEYS = DESIGN_INT_KEYS + ("dmsFontScale",)

die = vekrona_cli.make_die(PROG, __file__)
REPO = vekrona_cli.repo_root(__file__)

MARKER_TEXT = ("vekrona-render-theme: generated from the active vekrona theme, do not edit "
               "(run vekrona-theme or vekrona-render-theme)")
# Existing installs carry the marker of the removed vekrona-gtk-theme; accepted so they migrate.
LEGACY_MARKER = ("/* vekrona-gtk-theme: generated from the active vekrona theme, do not edit "
                 "(run vekrona-theme or vekrona-gtk-theme) */")
COMMENT_STYLES = {"css": ("/* ", " */"), "hash": ("# ", ""), "slash": ("// ", "")}


def marker(style):
    prefix, suffix = COMMENT_STYLES[style]
    return f"{prefix}{MARKER_TEXT}{suffix}"


# ---------------------------------------------------------------- inputs

def load_mode():
    path = os.path.join(vekrona_cli.vekrona_state_dir(), "theme")
    text = read_text(path)
    if text is None:
        die(f"{path} not found (run `vekrona-theme dark`)")
    mode = text.strip()
    if mode not in vekrona_theme.MODES:
        die(f"{path} says '{mode}', which is not dark or light (run `vekrona-theme dark`)")
    return mode


def load_tokens():
    try:
        return vekrona_theme.load(os.path.join(REPO, "config", "tokens.json"))
    except vekrona_theme.ThemeError as e:
        die(str(e))


def load_design():
    design_file = os.path.join(REPO, "config", "design.json")
    try:
        with open(design_file) as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        die(f"could not read {design_file}: {e}")
    if not isinstance(data, dict) or set(data) != set(DESIGN_KEYS):
        die(f"{design_file}: keys must be exactly {', '.join(DESIGN_KEYS)}")
    for key in DESIGN_INT_KEYS:
        value = data[key]
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            die(f"{design_file}: {key} is not a non-negative integer: {value!r}")
    scale = data["dmsFontScale"]
    if isinstance(scale, bool) or not isinstance(scale, (int, float)) or scale <= 0:
        die(f"{design_file}: dmsFontScale is not a positive number: {scale!r}")
    return data


# ---------------------------------------------------------------- files

def read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        return None
    except (OSError, UnicodeDecodeError) as e:
        die(f"could not read {path}: {e}")


def is_repo_symlink(path):
    """An old install symlinked its config files into the repo; those are ours to replace."""
    return os.path.islink(path) and os.path.realpath(path).startswith(REPO + os.sep)


def check_writable(path, style):
    if not os.path.lexists(path) or is_repo_symlink(path):
        return
    first_line = (read_text(path) or "").split("\n", 1)[0]
    if first_line not in (marker(style), LEGACY_MARKER):
        die(f"{path} exists and is not managed by vekrona (no marker header); move it away first")


def write_atomic(path, content):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except OSError as e:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        die(f"could not write {path}: {e}")


def write_managed(files):
    """files: {path: (comment_style, body)}. Checks every path before writing any.
    Returns the paths whose content changed."""
    for path, (style, _) in files.items():
        check_writable(path, style)
    changed = []
    for path, (style, body) in files.items():
        content = f"{marker(style)}\n{body}"
        if not os.path.islink(path) and read_text(path) == content:
            continue
        write_atomic(path, content)
        changed.append(path)
    return changed


def write_and_report(files):
    changed = write_managed(files)
    for path in files:
        print(f"{'wrote' if path in changed else 'unchanged'}: {path}")
    return changed


def home_path(*parts):
    return os.path.join(os.path.expanduser("~"), *parts)


def run_or_die(argv, what, env=None):
    try:
        result = subprocess.run(argv, capture_output=True, text=True, env=env, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        die(f"{what} failed: {e}")
    if result.returncode != 0:
        die(f"{what} failed (exit {result.returncode}): {result.stderr.strip()}")


# ---------------------------------------------------------------- dms

def apply_dms(theme, mode):
    path = os.path.join(vekrona_cli.vekrona_state_dir(), "active-theme.json")
    content = json.dumps(theme.active_theme(mode), indent=2) + "\n"
    if read_text(path) == content:
        print(f"unchanged: {path}")
        return
    write_atomic(path, content)
    print(f"wrote: {path}")


# ---------------------------------------------------------------- gtk

class TokenTemplate(string.Template):
    """${token-name} placeholders: token names contain hyphens."""
    idpattern = r"[a-z][a-z0-9-]*"


GTK_COLORS = TokenTemplate("""@define-color accent_color ${accent-ink};
@define-color accent_bg_color ${accent};
@define-color accent_fg_color ${on-accent};
@define-color destructive_color ${danger-ink};
@define-color destructive_bg_color ${danger};
@define-color destructive_fg_color ${on-danger};
@define-color error_color ${danger-ink};
@define-color error_bg_color ${danger};
@define-color error_fg_color ${on-danger};
@define-color warning_color ${warning};
@define-color warning_bg_color ${warning};
@define-color warning_fg_color ${on-warning};
@define-color success_color ${success};
@define-color success_bg_color ${success};
@define-color success_fg_color ${on-success};
@define-color window_bg_color ${surface-1};
@define-color window_fg_color ${ink};
@define-color view_bg_color ${surface-2};
@define-color view_fg_color ${ink};
@define-color headerbar_bg_color ${surface-1};
@define-color headerbar_fg_color ${ink};
@define-color headerbar_border_color ${line};
@define-color headerbar_backdrop_color ${surface-1};
@define-color headerbar_shade_color transparent;
@define-color sidebar_bg_color ${surface-1};
@define-color sidebar_fg_color ${ink};
@define-color sidebar_backdrop_color ${surface-1};
@define-color sidebar_border_color ${line};
@define-color sidebar_shade_color transparent;
@define-color card_bg_color ${surface-2};
@define-color card_fg_color ${ink};
@define-color card_shade_color transparent;
@define-color popover_bg_color ${surface-2};
@define-color popover_fg_color ${ink};
@define-color dialog_bg_color ${surface-2};
@define-color dialog_fg_color ${ink};
@define-color shade_color transparent;
@define-color vk_focus ${focus};
@define-color vk_line ${line};
@define-color vk_line_strong ${line-strong};
@define-color vk_surface_3 ${surface-3};
@define-color vk_disabled ${ink-disabled};
""")

# Check boxes, radios and switches. The node names are shared by libadwaita (gtk4) and adw-gtk3 (gtk3):
# check, radio, switch > slider. Boxes are square with a 1px line-strong edge on surface-2; checked is an
# accent fill with an on-accent mark; a radio shows a filled inner square instead; a switch is a
# surface-3 track (accent when on) with a square thumb. Disabled text uses ink-disabled.
GTK_CONTROLS = """
check, radio {
  min-width: 24px;
  min-height: 24px;
  background-color: @view_bg_color;
  border: 1px solid @vk_line_strong;
}
check:checked, check:indeterminate {
  background-color: @accent_bg_color;
  border-color: @accent_bg_color;
  color: @accent_fg_color;
}
radio:checked {
  background-color: @view_bg_color;
  background-image: linear-gradient(@accent_bg_color, @accent_bg_color);
  background-size: 12px 12px;
  background-position: center;
  background-repeat: no-repeat;
  -gtk-icon-source: none;
}
switch {
  min-width: 40px;
  min-height: 24px;
  background-color: @vk_surface_3;
  border: 1px solid @vk_line_strong;
}
switch:checked {
  background-color: @accent_bg_color;
  border-color: @accent_bg_color;
}
switch slider {
  min-width: 16px;
  min-height: 16px;
  margin: 3px;
  background-color: @window_fg_color;
  border: none;
}
switch:checked slider {
  background-color: @accent_fg_color;
}
*:disabled, label:disabled {
  color: @vk_disabled;
}
"""

# Flat, square and quiet: the selection signal is a 2px accent underline, never a fill. Rows and tabs
# reserve the underline's space with a transparent border so selecting one does not shift the layout.
GTK3_SHAPE = string.Template("""
* {
  border-radius: ${r}px;
  box-shadow: none;
  background-image: none;
  -gtk-outline-radius: ${r}px;
}
button, entry, spinbutton, combobox button, notebook > header > tabs > tab, scale trough, scrollbar slider {
  border: 1px solid @vk_line_strong;
}
button.flat, headerbar button:not(.suggested-action):not(.destructive-action), scale trough {
  border-color: transparent;
}
*:focus {
  outline: 1px solid @vk_focus;
  outline-offset: 2px;
}
headerbar, .titlebar {
  border-bottom: 1px solid @vk_line;
}
separator {
  background-color: @vk_line;
  min-width: 1px;
  min-height: 1px;
}
row, notebook > header > tabs > tab, stacksidebar row, button.flat:checked {
  border-bottom: 2px solid transparent;
}
row:selected, row:selected:focus, stacksidebar row:selected, notebook > header > tabs > tab:checked,
button.flat:checked, iconview:selected, iconview:selected:focus {
  background-color: transparent;
  color: @window_fg_color;
  border-bottom-color: @accent_bg_color;
}
treeview.view:selected, treeview.view:selected:focus {
  background-color: transparent;
  color: @view_fg_color;
  box-shadow: inset 0 -2px @accent_bg_color;
}
menu, .menu, .popup, popover.background, tooltip.background {
  background-color: @popover_bg_color;
  border: 1px solid @vk_line;
}
""")

GTK4_SHAPE = string.Template("""
* {
  border-radius: ${r}px;
  box-shadow: none;
  background-image: none;
}
button, entry, spinbutton, dropdown > button, .card, scale trough {
  border: 1px solid @vk_line_strong;
}
button.flat, headerbar button:not(.suggested-action):not(.destructive-action), scale trough {
  border-color: transparent;
}
*:focus:focus-visible, entry:focus-within, spinbutton:focus-within {
  outline: 1px solid @vk_focus;
  outline-offset: 2px;
}
headerbar, toolbarview > .top-bar {
  border-bottom: 1px solid @vk_line;
}
separator {
  background-color: @vk_line;
  min-width: 1px;
  min-height: 1px;
}
row, .navigation-sidebar > row, listview > row, columnview > listview > row, gridview > child, tab,
button.flat:checked {
  border-bottom: 2px solid transparent;
}
row:selected, .navigation-sidebar > row:selected, listview > row:selected, columnview > listview > row:selected,
gridview > child:selected, tab:selected, button.flat:checked {
  background-color: transparent;
  color: @window_fg_color;
  border-bottom-color: @accent_bg_color;
}
popover > contents, tooltip.background {
  background-color: @popover_bg_color;
  border: 1px solid @vk_line;
}
""")


def render_gtk(theme, mode, design):
    palette = GTK_COLORS.substitute(theme.colors[mode])
    r = design["radius"]
    return {
        home_path(".config", "gtk-3.0", "gtk.css"): ("css", palette + GTK3_SHAPE.substitute(r=r) + GTK_CONTROLS),
        home_path(".config", "gtk-4.0", "gtk.css"): ("css", palette + GTK4_SHAPE.substitute(r=r) + GTK_CONTROLS),
    }


def gsettings_argv(*args):
    bus = f"/run/user/{os.getuid()}/bus"
    if os.path.exists(bus):
        return ["gsettings", *args], {**os.environ, "DBUS_SESSION_BUS_ADDRESS": f"unix:path={bus}"}
    return ["dbus-run-session", "--", "gsettings", *args], os.environ


def gsettings_set(schema, key, value):
    argv, env = gsettings_argv("set", schema, key, value)
    run_or_die(argv, f"gsettings set {schema} {key}", env=env)


def font_spec(family, px):
    return f"{family} {vekrona_theme.fmt_pt(vekrona_theme.px_to_pt(px))}"


def apply_gtk(theme, mode, design):
    write_and_report(render_gtk(theme, mode, design))
    gtk_theme = "adw-gtk3-dark" if mode == "dark" else "adw-gtk3"
    interface = "org.gnome.desktop.interface"
    body = font_spec(theme.sans(), theme.type_px("body"))
    for key, value in (
        ("gtk-theme", gtk_theme),
        ("color-scheme", f"prefer-{mode}"),
        ("font-name", body),
        ("document-font-name", body),
        ("monospace-font-name", font_spec(theme.mono(), theme.type_px("mono"))),
    ):
        gsettings_set(interface, key, value)
    print(f"gtk theme: {gtk_theme}")


# ---------------------------------------------------------------- qt

# QPalette role order of qtct color schemes (Qt 6): 21 roles, each from a token.
QT_ROLES = (
    ("WindowText", "ink"), ("Button", "surface-2"), ("Light", "surface-3"), ("Midlight", "surface-2"),
    ("Dark", "line"), ("Mid", "line-strong"), ("Text", "ink"), ("BrightText", "ink"),
    ("ButtonText", "ink"), ("Base", "surface-2"), ("Window", "surface-1"), ("Shadow", "bg"),
    ("Highlight", "accent"), ("HighlightedText", "on-accent"), ("Link", "accent-ink"),
    ("LinkVisited", "ink-muted"), ("AlternateBase", "surface-1"), ("NoRole", "surface-1"),
    ("ToolTipBase", "surface-2"), ("ToolTipText", "ink"), ("PlaceholderText", "ink-muted"),
)
QT_DISABLED = {
    "WindowText": "ink-disabled", "Text": "ink-disabled", "ButtonText": "ink-disabled",
    "BrightText": "ink-disabled", "ToolTipText": "ink-disabled", "PlaceholderText": "ink-disabled",
    "HighlightedText": "ink-disabled", "Highlight": "surface-3",
}


def qt_palette(colors, disabled):
    return [colors[QT_DISABLED.get(role, token) if disabled else token] for role, token in QT_ROLES]


def render_qt(theme, mode):
    colors = theme.colors[mode]
    colors_path = home_path(".config", "qt6ct", "colors", "vekrona.conf")
    conf = f"""[Appearance]
style=Fusion
custom_palette=true
color_scheme_path={colors_path}
standard_dialogs=default

[Fonts]
general="{theme.sans()},{vekrona_theme.fmt_pt(vekrona_theme.px_to_pt(theme.type_px('body')))}"
fixed="{theme.mono()},{vekrona_theme.fmt_pt(vekrona_theme.px_to_pt(theme.type_px('mono')))}"
"""
    active = qt_palette(colors, disabled=False)
    disabled = qt_palette(colors, disabled=True)
    scheme = "[ColorScheme]\n" + "".join(
        f"{name}_colors={', '.join(palette)}\n"
        for name, palette in (("active", active), ("inactive", active), ("disabled", disabled))
    )
    return {
        home_path(".config", "qt6ct", "qt6ct.conf"): ("hash", conf),
        colors_path: ("hash", scheme),
    }


# ---------------------------------------------------------------- firefox

def firefox_profile_root():
    legacy = home_path(".mozilla", "firefox")
    if os.path.isdir(legacy):
        return legacy
    return os.path.join(vekrona_cli.xdg_config_home(), "mozilla", "firefox")


def read_profiles_ini():
    """Returns (root, parser), or None when Firefox has no profiles yet."""
    root = firefox_profile_root()
    ini = os.path.join(root, "profiles.ini")
    if not os.path.isfile(ini):
        return None
    parser = configparser.ConfigParser(interpolation=None)
    try:
        parser.read(ini)
    except (OSError, configparser.Error) as e:
        die(f"could not read {ini}: {e}")
    return root, parser


def profile_dir(root, parser, section):
    path = parser[section].get("Default" if section.startswith("Install") else "Path")
    if not path:
        return None
    relative = parser[section].get("IsRelative", "1") == "1" or section.startswith("Install")
    return os.path.join(root, path) if relative and not os.path.isabs(path) else path


def find_default_profile(root, parser):
    installs = [s for s in parser.sections() if s.startswith("Install") and parser[s].get("Default")]
    if len(installs) > 1:
        die(f"{os.path.join(root, 'profiles.ini')} has several [Install*] sections, "
            f"cannot tell the default profile: {', '.join(installs)}")
    if installs:
        return profile_dir(root, parser, installs[0])
    for section in parser.sections():
        if not section.startswith("Profile") or parser[section].get("Default") != "1":
            continue
        if parser[section].get("Name", "").startswith("vekrona-"):
            continue
        return profile_dir(root, parser, section)
    return None


def find_webapp_profiles(root, parser):
    dirs = [profile_dir(root, parser, s) for s in parser.sections()
            if s.startswith("Profile") and parser[s].get("Name", "").startswith("vekrona-")]
    return [d for d in dirs if d]


def render_user_js(mode):
    scheme = 0 if mode == "dark" else 1
    return f"""user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("browser.theme.toolbar-theme", {scheme});
user_pref("browser.theme.content-theme", {scheme});
"""


USER_CHROME = TokenTemplate("""
:root {
  --lwt-accent-color: ${surface-1} !important;
  --lwt-text-color: ${ink} !important;
  --toolbar-bgcolor: ${surface-1} !important;
