#!/usr/bin/env python3
import json
import os
import sys

PROG = "vekrona-rofi-theme"


def die(msg):
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(1)


def load_theme_colors():
    state_home = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    theme_file = os.path.join(state_home, "vekrona", "active-theme.json")
    if not os.path.isfile(theme_file):
        die(f"active theme file not found: {theme_file} (run vekrona-theme <name> first)")
    with open(theme_file) as f:
        data = json.load(f)
    dark = data.get("dark")
    if not dark:
        die(f"{theme_file} has no 'dark' section")
    return dark


def rofi_theme_str(colors):
    return f"""
* {{
    font: "JetBrainsMono Nerd Font 11";
    background: {colors['background']};
    foreground: {colors['backgroundText']};
    lightbg: {colors['surfaceContainer']};
    lightfg: {colors['surfaceText']};
    border-color: {colors['outline']};
    separatorcolor: {colors['outlineVariant']};
    normal-background: {colors['background']};
    normal-foreground: {colors['backgroundText']};
    alternate-normal-background: {colors['surfaceContainerLow']};
    alternate-normal-foreground: {colors['backgroundText']};
    selected-normal-background: {colors['primary']};
    selected-normal-foreground: {colors['primaryText']};
    active-background: {colors['background']};
    active-foreground: {colors['secondary']};
    alternate-active-background: {colors['surfaceContainerLow']};
    alternate-active-foreground: {colors['secondary']};
    selected-active-background: {colors['primary']};
    selected-active-foreground: {colors['primaryText']};
    urgent-background: {colors['background']};
    urgent-foreground: {colors['error']};
    alternate-urgent-background: {colors['surfaceContainerLow']};
    alternate-urgent-foreground: {colors['error']};
    selected-urgent-background: {colors['error']};
    selected-urgent-foreground: {colors['errorText']};
}}
window {{
    border: 2px;
    width: 60%;
}}
listview {{
    lines: 18;
}}
"""


def main():
    colors = load_theme_colors()
    print(rofi_theme_str(colors))


if __name__ == "__main__":
    main()
