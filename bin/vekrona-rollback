#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$ROOT/lib/common.sh"

usage() {
  echo "usage: $(basename "$0") [--yes] <snapshot-number>" >&2
  exit 1
}

[[ $EUID -eq 0 ]] || exec sudo "$(readlink -f "${BASH_SOURCE[0]}")" "$@"

require_cmd findmnt mount umount mountpoint mktemp btrfs

confirm=1
number=""
for arg in "$@"; do
  case "$arg" in
    --yes) confirm=0 ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) [[ -z "$number" ]] || usage; number="$arg" ;;
  esac
done
[[ "$number" =~ ^[0-9]+$ ]] || usage

has_tty() { : < /dev/tty; } 2>/dev/null

if [[ $confirm -eq 1 ]] && ! has_tty; then
  die "refusing to prompt without a controlling tty; re-run with --yes"
fi

device="$(findmnt -no SOURCE /)"
device="${device%%\[*}"
[[ -n "$device" ]] || die "could not determine btrfs device of /"

mountpoint_dir="$(mktemp -d)"
mount -o subvolid=5 "$device" "$mountpoint_dir"
cleanup() {
  if mountpoint -q "$mountpoint_dir" 2>/dev/null; then
    umount "$mountpoint_dir" 2>/dev/null || true
  fi
  rmdir "$mountpoint_dir" 2>/dev/null || true
}
trap cleanup EXIT

snapshot_dir="$mountpoint_dir/root/.snapshots/$number/snapshot"
[[ -d "$snapshot_dir" ]] || die "snapshot not found: $snapshot_dir"

kernel_mismatch=0
kernel_list="$(ls "$snapshot_dir/lib/modules" 2>/dev/null || true)"
for vmlinuz in /boot/vmlinuz-*; do
  [[ -e "$vmlinuz" ]] || continue
  kernel="${vmlinuz#/boot/vmlinuz-}"
  [[ "$kernel" == 0-rescue-* ]] && continue
  if ! grep -qxF "$kernel" <<<"$kernel_list"; then
    warn "kernel $kernel (current /boot) has no matching /lib/modules in snapshot $number"
    kernel_mismatch=1
  fi
done

if [[ $confirm -eq 1 ]]; then
  read -r -p "Roll back / to snapshot $number? This renames the current root subvolume. [y/N] " answer < /dev/tty
  [[ "$answer" == "y" || "$answer" == "Y" ]] || die "aborted"
fi

new_root="$mountpoint_dir/root.vekrona-new"
log "creating writable snapshot $number at $new_root"
btrfs subvolume snapshot "$snapshot_dir" "$new_root"
[[ -d "$new_root" ]] || die "snapshot creation did not produce: $new_root"

backup="root.old-$(date +%Y%m%d%H%M%S)"
log "renaming $mountpoint_dir/root -> $mountpoint_dir/$backup"
mv "$mountpoint_dir/root" "$mountpoint_dir/$backup"

log "promoting snapshot $number to root"
mv "$new_root" "$mountpoint_dir/root"

if [[ -d "$mountpoint_dir/root/.snapshots" ]]; then
  rmdir "$mountpoint_dir/root/.snapshots" || die "root/.snapshots exists and is not empty, resolve manually"
fi
mv "$mountpoint_dir/$backup/.snapshots" "$mountpoint_dir/root/.snapshots"

marker="$mountpoint_dir/root/.vekrona-rolled-back-from-$number"
: > "$marker"
[[ -f "$marker" ]] || die "failed to write rollback marker: $marker"

log "rollback complete: / now points at snapshot $number, previous root kept as $backup"
log "reboot to boot into the restored root: systemctl reboot"
if [[ $kernel_mismatch -eq 1 ]]; then
  warn "/boot is a separate filesystem and was NOT rolled back; the running kernel may be missing from the restored root, see warnings above"
fi
