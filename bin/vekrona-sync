#!/usr/bin/env python3
"""Syncthing for the desktop: share a folder, join an offered one, accept a device, send a file, and the watcher that
keeps $XDG_STATE_HOME/vekrona/sync.json (the bar's Sync popout) up to date.

Every call goes to Syncthing's REST API over the unix socket named by <gui><address> in its config.xml, with the API key
from the same file. A failure exits 1 with Syncthing's message on stderr.

  id                      print this computer's device ID, which another device adds to connect
  qr                      write the device ID as a QR code (a PNG in the state directory) and print its path, for a phone
                          to scan
  pair DEVICE [NAME]      add a device by its ID (as typed or pasted: any case, with or without dashes) and share every
                          folder with it; it appears under My devices as soon as it adds this computer too
  share [PATH]            share a directory with every device of this computer and print its folder ID (no PATH: the file
                          chooser portal)
  join FOLDER [PATH]      take a folder that another device offers, into PATH or ~/Sync/<its label>
  accept DEVICE           add a device that asked to connect, and share every folder with it
  reject DEVICE           ignore a device that asked to connect, for good: it asks no more
  send DEVICE [FILE...]   drop files into DEVICE's ~/Downloads, now or when it is next online (no FILE: the portal)
  nearby                  print the device ID of each nearby device in sync.json that answers on a TCP address it announced,
                          one per line; the popout lists only those
  seen                    mark every received file as seen
  watch                   the service: follow Syncthing's events, write sync.json, notify, receive dropped files; exits
                          75 when Syncthing does not answer (systemd starts it again, later each time) and 78 when
                          Syncthing's configuration is wrong (systemd does not start it again)
  offline                 write sync.json as "Syncthing is not running"; the service's ExecStopPost

A drop is a folder vekrona-drop-<a>-<b> (the full IDs of the two devices, sorted) that only those two share. The sender
puts files in to/<receiver>/, and the receiver's watch moves them out into ~/Downloads, which syncs the deletion back. A peer
controls what its drop folders hold, so every step into to/<receiver>/ refuses a link, and a drop folder that a third
device shares is neither used nor offered."""
import argparse
import concurrent.futures
import contextlib
import dataclasses
import datetime
import errno
import fcntl
import functools
import http.client
import ipaddress
import itertools
import json
import os
import re
import secrets
import shutil
import socket
import subprocess
import stat
import sys
import threading
import unicodedata
import urllib.parse
import xml.etree.ElementTree as ET

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import vekrona_cli

PROG = "vekrona-sync"

PATHS_TIMEOUT_SEC = 10
REQUEST_TIMEOUT_SEC = 30
# The events long-poll returns an empty list after this long; the HTTP timeout must outlast it.
EVENT_POLL_SEC = 3600
EVENT_SLACK_SEC = 60
# What `watch` exits with, which vekrona-sync.service maps: Syncthing does not answer (a success to systemd, which starts
# the watcher again with growing delays, so that Syncthing's start is no failure), or Syncthing's configuration is wrong
# (a failure that systemd does not retry).
EXIT_UNREACHABLE = 75
EXIT_CONFIG = 78
# The events that can change what sync.json shows, or deliver a file.
EVENT_TYPES = ("ConfigSaved", "StateChanged", "FolderSummary", "DeviceConnected", "DeviceDisconnected",
               "PendingDevicesChanged", "PendingFoldersChanged", "DeviceDiscovered", "ItemFinished")
# What these events change is not in their data: the whole snapshot is read again.
REREAD_EVENTS = frozenset({"ConfigSaved", "PendingDevicesChanged", "PendingFoldersChanged", "DeviceDiscovered"})
NOTIFY_TIMEOUT_SEC = 3600
NOTIFY_SEND_TIMEOUT_SEC = 5
# A device on the same network answers a TCP connect within milliseconds; one that has left does not, and its address is
# refused at once or the connect hangs, so this is how long the popout waits for the Nearby list when the device is gone.
NEARBY_PROBE_TIMEOUT_SEC = 1
QR_PIXELS_PER_MODULE = 8
QR_QUIET_ZONE_MODULES = 2
MAX_ARRIVALS = 20

DEVICE_ID = r"[A-Z2-7]{7}(?:-[A-Z2-7]{7}){7}"
DEVICE_ID_RE = re.compile(DEVICE_ID)
DROP_PREFIX = "vekrona-drop-"
DROP_ID_RE = re.compile(rf"{DROP_PREFIX}({DEVICE_ID})-({DEVICE_ID})")
DROP_LABEL = "vekrona drop"
BUSY_STATES = frozenset({"scan-waiting", "scanning", "sync-waiting", "sync-preparing", "syncing", "cleaning",
                         "clean-waiting"})


class SyncError(Exception):
    """A failure the caller reports as is: Syncthing's refusal, a missing file, a bad argument."""


class Unreachable(SyncError):
    """Syncthing does not answer on its socket (not running yet, restarting, or gone)."""


class ConfigError(SyncError):
    """Syncthing's configuration cannot be used however often it is read again."""


class MissingTool(SyncError):
    """An external program that is not installed."""


# The stage that installs the desktop packages, which every external tool of vekrona-sync belongs to.
PACKAGES_STAGE = 30


def run_tool(purpose, argv, **kwargs):
    """subprocess.run for every external program here, so that one that is not installed is said in plain words, with the
    stage that installs it, and any other failure to start it is a SyncError as well."""
    try:
        return subprocess.run(argv, **kwargs)
    except FileNotFoundError as exc:
        # A program named by its path is one of vekrona's own that was found and is gone; a bare name is a package's.
        way_out = "it is gone" if os.path.isabs(argv[0]) else (
            f"it comes with the desktop packages: run `./install.sh {PACKAGES_STAGE}` in the vekrona checkout")
        raise MissingTool(f"{purpose} needs {argv[0]}, which is not installed; {way_out}") from exc
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise SyncError(f"cannot run {argv[0]} for {purpose}: {exc}")


def device_id_arg(text):
    if not DEVICE_ID_RE.fullmatch(text):
        raise argparse.ArgumentTypeError(f"{text!r} is not a device ID (eight groups of seven letters and digits)")
    return text


def short_code(device_id):
    first_group = device_id.split("-")[0]
    return f"{first_group[:4]}-{first_group[4:]}"


def device_name(device_id, name):
    return name or short_code(device_id)


def sanitize_label(label, folder_id):
    """A directory name from a folder's label: no "/", no "..", no leading dots, no control characters. A label that
    leaves nothing is replaced by the folder's ID, cleaned the same way, because the ID comes from the offering device too."""
    for text in (label, folder_id):
        kept = "".join(c for c in text if c != "/" and unicodedata.category(c)[0] != "C")
        while ".." in kept:
            kept = kept.replace("..", "")
        name = kept.strip().lstrip(".").strip()
        if name:
            return name
    raise SyncError(f"cannot make a directory name from the label {label!r} or the folder ID {folder_id!r}")


def drop_folder_id(device_a, device_b):
    low, high = sorted((device_a, device_b))
    return f"{DROP_PREFIX}{low}-{high}"


def drop_parties(folder_id):
    """The two device IDs of a drop folder's ID, or None when the ID is no drop's. IDs are used whole: Syncthing sets no
    limit that a 142-character folder ID would break, and a short form would let two devices share one drop."""
    match = DROP_ID_RE.fullmatch(folder_id)
    if match is None or match[1] >= match[2]:
        return None
    return match[1], match[2]


def is_drop(folder_id):
    return folder_id.startswith(DROP_PREFIX)


def drop_partner(folder_id, my_id):
    """The other device of a drop folder that this device is a party to, else None."""
    parties = drop_parties(folder_id)
    if parties is None or my_id not in parties:
        return None
    return parties[1] if parties[0] == my_id else parties[0]


def auto_accepts(folder_id, offering_device, my_id):
    """A pending folder is taken without asking only when it is the drop between this device and the one offering it."""
    return drop_partner(folder_id, my_id) == offering_device


def is_syncthing_temp(name):
    return name.startswith("~syncthing~") or (name.startswith(".syncthing.") and name.endswith(".tmp"))


def candidate_names(name):
    stem, extension = os.path.splitext(name)
    yield name
    for number in itertools.count(2):
        yield f"{stem} ({number}){extension}"


DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC


def open_subdir(parent_fd, name, create):
    """The fd of the directory `name` in parent_fd, never through a link; None when it is missing and create is false."""
    try:
        return os.open(name, DIR_FLAGS, dir_fd=parent_fd)
    except FileNotFoundError:
        if not create:
            return None
    try:
        os.mkdir(name, 0o700, dir_fd=parent_fd)
    except FileExistsError:
        pass
    return os.open(name, DIR_FLAGS, dir_fd=parent_fd)


@contextlib.contextmanager
def open_inbox(drop_path, device_id, create):
    """Yields the fd of drop_path/to/device_id, or None when it is missing and create is false. A peer controls what a drop
    folder holds, so "to" and the device's directory are opened one at a time with O_NOFOLLOW: a link in their place is
    an error, and never a way to reach files outside the drop. Everything in the inbox is then reached through the fd."""
    try:
        if create:
            os.makedirs(drop_path, exist_ok=True)
        fd = os.open(drop_path, DIR_FLAGS)
    except FileNotFoundError:
        fd = None
    except OSError as exc:
        raise SyncError(f"cannot open the drop folder {drop_path}: {exc}")
    try:
        for name in ("to", device_id):
            if fd is None:
                break
            try:
                child = open_subdir(fd, name, create)
            except OSError as exc:
                if exc.errno in (errno.ELOOP, errno.ENOTDIR):
                    raise SyncError(f"{name} in the drop folder {drop_path} is a link or not a directory, which only another "
                                    f"device can have made of it, so nothing is moved through it")
                raise SyncError(f"cannot open {name} in the drop folder {drop_path}: {exc}")
            os.close(fd)
            fd = child
        yield fd
    finally:
        if fd is not None:
            os.close(fd)


def place_without_overwriting(source_fd, source_name, directory_fd, name):
    """Links the file source_name of source_fd into directory_fd as name, or as `name (2)`, `name (3)` before the extension
    while those exist, and returns the name it got. The source stays. A directory on another filesystem gets a copy, made
    under a temp name first."""
    try:
        return link_unused(source_fd, source_name, directory_fd, name)
    except OSError as exc:
        if exc.errno != errno.EXDEV:
            raise
    staged = f".vekrona-sync.{secrets.token_hex(4)}.tmp"
    with os.fdopen(os.open(source_name, FILE_FLAGS, dir_fd=source_fd), "rb") as source:
        stage_copy(source, directory_fd, staged)
    try:
        return link_unused(directory_fd, staged, directory_fd, name)
    finally:
        os.unlink(staged, dir_fd=directory_fd)


def link_unused(source_fd, source_name, directory_fd, name):
    for candidate in candidate_names(name):
        try:
            os.link(source_name, candidate, src_dir_fd=source_fd, dst_dir_fd=directory_fd, follow_symlinks=False)
        except FileExistsError:
            continue
        return candidate


def stage_copy(source, directory_fd, name):
    """Copies the open file `source` to the new file `name` of directory_fd, with its mode and times."""
    info = os.fstat(source.fileno())
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=directory_fd)
    try:
        with os.fdopen(fd, "wb") as target:
            shutil.copyfileobj(source, target)
            os.fchmod(fd, stat.S_IMODE(info.st_mode))
        os.utime(name, ns=(info.st_atime_ns, info.st_mtime_ns), dir_fd=directory_fd, follow_symlinks=False)
    except BaseException:
        os.unlink(name, dir_fd=directory_fd)
        raise


def drops_root():
    return os.path.join(vekrona_cli.xdg_data_home(), "vekrona-sync", "drops")


def sync_root():
    return os.path.join(os.path.expanduser("~"), "Sync")


def downloads_dir():
    try:
        result = run_tool("finding Downloads", ["xdg-user-dir", "DOWNLOAD"], capture_output=True, text=True,
                          timeout=PATHS_TIMEOUT_SEC)
    except MissingTool:
        return os.path.join(os.path.expanduser("~"), "Downloads")
    if result.returncode != 0:
        raise SyncError(f"xdg-user-dir DOWNLOAD exited with status {result.returncode}: {result.stderr.strip()}")
    # xdg-user-dir answers $HOME for a directory the user never set.
    path = result.stdout.strip()
    return path if path != os.path.expanduser("~") else os.path.join(path, "Downloads")


# ---- Syncthing, the one place that knows where it listens ----------------------------------------------------------

@functools.cache
def syncthing_config_file():
    result = run_tool("finding Syncthing's configuration", ["syncthing", "paths"], capture_output=True, text=True,
                      timeout=PATHS_TIMEOUT_SEC)
    if result.returncode != 0:
        raise SyncError(f"`syncthing paths` exited with status {result.returncode}: {result.stderr.strip()}")
    lines = result.stdout.splitlines()
    for index, line in enumerate(lines):
        if line.startswith("Configuration file:"):
            for following in lines[index + 1:]:
                if following.strip():
                    return following.strip()
    raise SyncError("`syncthing paths` names no configuration file")


def gui_endpoint(config_file):
    """The socket path and the API key from <gui> of config.xml. The address is a bare absolute path or unix:///path."""
    try:
        gui = ET.parse(config_file).getroot().find("gui")
    except FileNotFoundError as exc:
        raise Unreachable(f"Syncthing has not written {config_file} yet") from exc
    except (OSError, ET.ParseError) as exc:
        raise ConfigError(f"cannot read {config_file}: {exc}")
    address = gui.findtext("address") if gui is not None else None
    api_key = gui.findtext("apikey") if gui is not None else None
    if not address or not api_key:
        raise ConfigError(f"{config_file} has no <gui> address and apikey")
    path = address.removeprefix("unix://").split("?", 1)[0]
    if not os.path.isabs(path):
        raise ConfigError(f"{config_file}: the GUI address {address!r} is not a unix socket (stage 50 sets one)")
    return path, api_key


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, socket_path, timeout):
        super().__init__("localhost", timeout=timeout)
        self.socket_path = socket_path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.socket_path)


class Syncthing:
    def __init__(self, socket_path, api_key):
        self.socket_path = socket_path
        self.api_key = api_key

    @classmethod
    def from_config(cls):
        return cls(*gui_endpoint(syncthing_config_file()))

    def request(self, method, path, query=None, body=None, timeout=REQUEST_TIMEOUT_SEC):
        """The decoded JSON answer, or None for an empty one. Syncthing's own message is in the SyncError of a refusal."""
        target = path if not query else f"{path}?{urllib.parse.urlencode(query)}"
        headers = {"X-API-Key": self.api_key}
        payload = None
        if body is not None:
            payload = json.dumps(body)
            headers["Content-Type"] = "application/json"
        connection = UnixHTTPConnection(self.socket_path, timeout)
        try:
            connection.request(method, target, payload, headers)
            response = connection.getresponse()
            data = response.read()
        except (OSError, http.client.HTTPException) as exc:
            raise Unreachable(f"cannot reach Syncthing at {self.socket_path}: {exc}") from exc
        finally:
            connection.close()
        if not 200 <= response.status < 300:
            raise SyncError(f"Syncthing refused {method} {path} with HTTP {response.status}: "
                            f"{data.decode(errors='replace').strip()}")
        if not data.strip():
            return None
        try:
            return json.loads(data)
        except ValueError as exc:
            raise SyncError(f"Syncthing answered {method} {path} with something that is not JSON: {exc}")

    def my_id(self):
        return self.request("GET", "/rest/system/status")["myID"]

    def events(self, since, limit=None, timeout_sec=EVENT_POLL_SEC):
        query = {"since": since, "timeout": timeout_sec, "events": ",".join(EVENT_TYPES)}
        if limit is not None:
            query["limit"] = limit
        return self.request("GET", "/rest/events", query=query, timeout=timeout_sec + EVENT_SLACK_SEC)

    def latest_event_id(self):
        events = self.events(since=0, limit=1, timeout_sec=1)
        return events[-1]["id"] if events else 0

    def add_folder(self, folder_id, label, path, device_ids):
        folder = self.request("GET", "/rest/config/defaults/folder")
        folder.update(id=folder_id, label=label, path=path, type="sendreceive",
                      devices=[{"deviceID": device_id} for device_id in device_ids])
        self.request("POST", "/rest/config/folders", body=folder)

    def share_folder_with(self, folder, *device_ids):
        shared = {device["deviceID"] for device in folder["devices"]}
        added = [{"deviceID": device_id} for device_id in dict.fromkeys(device_ids) if device_id not in shared]
        if added:
            self.request("PATCH", f"/rest/config/folders/{urllib.parse.quote(folder['id'], safe='')}",
                         body={"devices": [*folder["devices"], *added]})

    def canonical_device_id(self, text):
        """The ID as Syncthing writes it, from what a person typed or pasted: Syncthing is the one that knows the format (case,
        dashes, look-alike characters, the check digits), so it is asked, and its refusal is the message."""
        candidate = text.strip()
        if not candidate:
            raise SyncError("no device ID given")
        answer = self.request("GET", "/rest/svc/deviceid", query={"id": candidate})
        if "error" in answer:
            raise SyncError(answer["error"])
        return answer["id"]

    def ignore_device(self, device_id, name, address):
        """Puts the device on the list of devices whose connection attempts Syncthing drops without a word. The REST API
        takes that list only inside the whole configuration."""
        config = self.request("GET", "/rest/config")
        if any(ignored["deviceID"] == device_id for ignored in config["remoteIgnoredDevices"]):
            return
        config["remoteIgnoredDevices"].append({"deviceID": device_id, "name": name, "address": address,
                                               "time": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")})
        self.request("PUT", "/rest/config", body=config)


# ---- What sync.json shows --------------------------------------------------------------------------------------------

@dataclasses.dataclass
class Snapshot:
    my_id: str
    folders: list
    devices: list
    connected: set
    pending_devices: dict
    pending_folders: dict
    statuses: dict
    # Local discovery's cache, by device ID: every device that announced itself on the network, configured or not.
    discovered: dict
    ignored: frozenset


def folder_status(api, folder):
    try:
        return api.request("GET", "/rest/db/status", query={"folder": folder["id"]})
    except Unreachable:
        raise
    except SyncError as exc:
        # A folder Syncthing cannot report on is that folder's problem on screen, not the end of the watcher.
        return {"state": "error", "error": str(exc)}


def read_snapshot(api, my_id):
    config = api.request("GET", "/rest/config")
    folders = config["folders"]
    connections = api.request("GET", "/rest/system/connections")["connections"]
    return Snapshot(
        my_id=my_id, folders=folders, devices=config["devices"],
        connected={device_id for device_id, connection in connections.items() if connection["connected"]},
        pending_devices=api.request("GET", "/rest/cluster/pending/devices"),
        pending_folders=api.request("GET", "/rest/cluster/pending/folders"),
        discovered=api.request("GET", "/rest/system/discovery"),
        ignored=frozenset(ignored["deviceID"] for ignored in config["remoteIgnoredDevices"]),
        statuses={folder["id"]: folder_status(api, folder) for folder in folders
                  if not is_drop(folder["id"]) and not folder.get("paused", False)})


def apply_event(snapshot, event):
    """Brings the snapshot up to date with an event whose data says all there is to know. A folder's summary and state
    changes come in the events, so a folder is asked about once, when the snapshot is read."""
    data = event["data"]
    if event["type"] == "DeviceConnected":
        snapshot.connected.add(data["id"])
    elif event["type"] == "DeviceDisconnected":
        snapshot.connected.discard(data["id"])
    elif data.get("folder") in snapshot.statuses:
        status = snapshot.statuses[data["folder"]]
        if event["type"] == "FolderSummary":
            snapshot.statuses[data["folder"]] = data["summary"]
        elif event["type"] == "StateChanged":
            snapshot.statuses[data["folder"]] = {**status, "state": data["to"], "error": data.get("error")}


def folder_view(folder, status):
    path = os.path.expanduser(folder["path"])
    view = {"id": folder["id"], "label": folder.get("label") or os.path.basename(path.rstrip("/")) or folder["id"],
            "path": path, "state": "idle", "progress": 100, "problem": None}
    if folder.get("paused", False):
        return {**view, "state": "problem", "progress": 0, "problem": "Paused"}
    state = status["state"]
    if state == "error":
        return {**view, "state": "problem", "progress": 0,
                "problem": status.get("error") or "Syncthing reports an error for this folder"}
    if state in BUSY_STATES:
        total, needed = status.get("globalBytes", 0), status.get("needBytes", 0)
        progress = 0 if total <= 0 else max(0, min(100, int(100 * (total - needed) / total)))
        return {**view, "state": "syncing", "progress": progress}
    if state != "idle":
        return {**view, "state": "problem", "progress": 0, "problem": f"Syncthing reports the state {state!r}"}
    failed = status.get("pullErrors", 0)
    if failed > 0:
        return {**view, "state": "problem", "problem": f"{failed} items could not be synced"}
    return view


def overall(folders):
    for folder in folders:
        if folder["state"] == "problem":
            return "problem", folder["problem"]
    if any(folder["state"] == "syncing" for folder in folders):
        return "syncing", None
    return "idle", None


def assemble(snapshot):
    """The sync.json of a Syncthing that answered, without its arrivals."""
    names = {device["deviceID"]: device_name(device["deviceID"], device.get("name")) for device in snapshot.devices}
    folders = [folder_view(folder, snapshot.statuses.get(folder["id"])) for folder in snapshot.folders
               if not is_drop(folder["id"])]
    state, problem = overall(folders)
    # A nearby device is one that announced itself and that no list knows yet: not this computer, not a device of it, not
    # one that already asked (it is under New devices), and not one that was rejected.
    known = names.keys() | snapshot.pending_devices.keys() | snapshot.ignored | {snapshot.my_id}
    # A drop is never offered for a click: the one of the other party is taken without asking, and any other is a device
    # pretending to be one.
    offers = [{"folder": folder_id, "label": offer.get("label") or folder_id, "device": device_id,
               "deviceName": names.get(device_id, short_code(device_id))}
              for folder_id, entry in snapshot.pending_folders.items() if not is_drop(folder_id)
              for device_id, offer in entry["offeredBy"].items()]
    return {
        "state": state, "problem": problem, "me": {"id": snapshot.my_id, "code": short_code(snapshot.my_id)},
        "folders": folders, "offers": offers,
        "nearby": [{"id": device_id, "code": short_code(device_id), "addresses": announcement["addresses"]}
                   for device_id, announcement in sorted(snapshot.discovered.items()) if device_id not in known],
        "pendingDevices": [{"id": device_id, "name": device_name(device_id, info.get("name")),
                            "code": short_code(device_id)}
                           for device_id, info in snapshot.pending_devices.items()],
        "devices": [{"id": device_id, "name": name, "connected": device_id in snapshot.connected}
                    for device_id, name in names.items() if device_id != snapshot.my_id]}


def offline_view():
    return {"state": "offline", "problem": "Syncthing is not running", "me": None, "folders": [], "offers": [],
            "nearby": [], "pendingDevices": [], "devices": []}


class StateStore:
    """sync.json. The watcher and `seen` both rewrite it, so every change is a locked read-modify-write."""

    def __init__(self, report):
        directory = vekrona_cli.vekrona_state_dir()
        self.path = os.path.join(directory, "sync.json")
        self.lock_path = os.path.join(directory, "sync.json.lock")
        self.report = report

    def read(self):
        """The file's content, None when there is none or it is not a sync.json (reported, since the next write replaces it)."""
        try:
            with open(self.path) as f:
                current = json.load(f)
        except FileNotFoundError:
            return None
        except (OSError, ValueError) as exc:
            self.report(f"cannot read {self.path}, which is replaced by the next state: {exc}")
            return None
        if not isinstance(current, dict) or not isinstance(current.get("arrivals"), list):
            self.report(f"{self.path} is no sync.json, which is replaced by the next state")
            return None
        return current

    def update(self, change):
        """Writes what change(current or None) returns, unless it returns None."""
        os.makedirs(os.path.dirname(self.lock_path), exist_ok=True)
        with open(self.lock_path, "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            changed = change(self.read())
            if changed is not None:
                vekrona_cli.write_json_atomically(self.path, changed)

    def publish(self, view, new_arrivals):
        def change(current):
            old = [] if current is None else current["arrivals"]
            state = {**view, "arrivals": (new_arrivals + old)[:MAX_ARRIVALS]}
            return None if state == current else state
        self.update(change)

    def mark_seen(self):
        def change(current):
            if current is None or not any(arrival["unseen"] for arrival in current["arrivals"]):
                return None
            return {**current, "arrivals": [{**arrival, "unseen": False} for arrival in current["arrivals"]]}
        self.update(change)


# ---- Nearby ----------------------------------------------------------------------------------------------------------

def tcp_endpoints(addresses):
    """The (host, port) of each tcp://, tcp4:// and tcp6:// address with an IP and a port that a device announced. QUIC runs
    over UDP, which a connect cannot test. A name is not tried: any device on the network can announce one, and looking it up
    would be a request to wherever it points."""
    endpoints = []
    for address in addresses:
        try:
            url = urllib.parse.urlsplit(address)
            if url.scheme in ("tcp", "tcp4", "tcp6") and url.port:
                ipaddress.ip_address(url.hostname)
                endpoints.append((url.hostname, url.port))
        except ValueError:
            continue
    return endpoints


def accepts_connection(endpoint, timeout_sec):
    try:
        with socket.create_connection(endpoint, timeout=timeout_sec):
            return True
    except OSError:
        return False


def answering_nearby(nearby, timeout_sec=NEARBY_PROBE_TIMEOUT_SEC):
    """The IDs of the devices of sync.json's nearby list that are there now. Syncthing's discovery cache never forgets a
    device (its entries carry no time in the REST API, and none expires), so a device is there when one of its announced TCP
    addresses accepts a connection, tried for all of them at once. A device that announced no TCP address cannot be tried and
    stays listed, as without this check."""
    endpoints = {device["id"]: tcp_endpoints(device["addresses"]) for device in nearby}
    attempts = [(device_id, endpoint) for device_id, device_endpoints in endpoints.items() for endpoint in device_endpoints]
    if not attempts:
        return [device["id"] for device in nearby]
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(attempts)) as pool:
        answered = pool.map(lambda attempt: accepts_connection(attempt[1], timeout_sec), attempts)
        reached = {device_id for (device_id, _), ok in zip(attempts, answered) if ok}
    return [device["id"] for device in nearby if device["id"] in reached or not endpoints[device["id"]]]


# ---- Receiving -----------------------------------------------------------------------------------------------------

def finished_files(inbox_fd):
    try:
        with os.scandir(inbox_fd) as entries:
            # Syncthing writes a file under a temp name and renames it when it is whole, so a name that is no temp name is a
            # file that finished. Links and directories are not files that someone sent.
            return sorted(entry.name for entry in entries
                          if entry.is_file(follow_symlinks=False) and not is_syncthing_temp(entry.name))
    except OSError as exc:
        raise SyncError(f"cannot list the inbox of a drop folder: {exc}")


def receive(drop_path, my_id, sender):
    """Moves the finished files of the inbox of drop_path into Downloads and returns (arrivals, failures)."""
    with open_inbox(drop_path, my_id, create=False) as inbox:
        names = [] if inbox is None else finished_files(inbox)
        if not names:
            return [], []
        downloads = downloads_dir()
        try:
            os.makedirs(downloads, exist_ok=True)
            downloads_fd = os.open(downloads, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        except OSError as exc:
            raise SyncError(f"cannot use {downloads} for received files: {exc}")
        try:
            arrivals, failures = [], []
            for name in names:
                try:
                    placed = place_without_overwriting(inbox, name, downloads_fd, name)
                    # The file may have become a link between the listing and the move, and a link must not land in Downloads.
                    if not stat.S_ISREG(os.stat(placed, dir_fd=downloads_fd, follow_symlinks=False).st_mode):
                        os.unlink(placed, dir_fd=downloads_fd)
                        raise OSError(errno.EMLINK, f"{name} became a link while it was moved")
                    os.unlink(name, dir_fd=inbox)
                except OSError as exc:
                    failures.append(f"cannot move {name} of the drop folder {drop_path} to {downloads}: {exc}")
                else:
                    arrivals.append({"name": placed, "path": os.path.join(downloads, placed), "from": sender,
                                     "unseen": True})
            return arrivals, failures
        finally:
            os.close(downloads_fd)


# ---- Notifications ---------------------------------------------------------------------------------------------------

class DesktopNotifier:
    """Each question runs in a thread of its own, because the answer can take an hour and the watcher must not wait."""

    def __init__(self, report):
        self.report = report

    def pairing(self, device, accept, reject):
        self.ask(f"{device['name']} wants to connect",
                 f"Check that its device code starts with {device['code']}, then accept.",
                 [("later", "Not now", None), ("accept", "Accept", accept), ("reject", "Reject", reject)])

    def offer(self, offer, join):
        self.ask(f"{offer['deviceName']} offers a folder", offer["label"],
                 [("later", "Not now", None), ("join", "Join", join)])

    def arrival(self, arrival):
        try:
            result = run_tool("telling that a file arrived",
                              ["notify-send", "-a", "vekrona", "--", f"{arrival['name']} received",
                               f"From {arrival['from']}, in {os.path.dirname(arrival['path'])}"],
                              capture_output=True, text=True, timeout=NOTIFY_SEND_TIMEOUT_SEC)
        except SyncError as exc:
            self.report(str(exc))
            return
        if result.returncode != 0:
            self.report(f"cannot show the arrival of {arrival['name']}: notify-send exited with status "
                        f"{result.returncode}: {result.stderr.strip()}")

    def ask(self, title, body, choices):
        """choices: (key, label, action or None); the first is the harmless one, which vekrona-update-ask requires."""
        tool = vekrona_cli.resolve_tool(__file__, "vekrona-update-ask")
        if tool is None:
            self.report("vekrona-update-ask not found, so no notification can ask a question")
            return
        argv = [tool, "--timeout", str(NOTIFY_TIMEOUT_SEC), "--title", title, "--body", body]
        for key, label, _ in choices:
            argv += ["--action", f"{key}={label}"]
        threading.Thread(target=self.wait_for_answer, args=(argv, {key: action for key, _, action in choices}),
                         daemon=True).start()

    def wait_for_answer(self, argv, actions):
        try:
            result = run_tool("asking a question in a notification", argv, capture_output=True, text=True)
        except SyncError as exc:
            self.report(str(exc))
            return
        if result.returncode != 0:
            self.report(f"{os.path.basename(argv[0])} exited with status {result.returncode}: {result.stderr.strip()}")
            return
        action = actions.get(result.stdout.strip())
        if action is None:
            return
        try:
            action()
        except SyncError as exc:
            self.report(str(exc))


# ---- The commands ----------------------------------------------------------------------------------------------------

def other_devices(api, my_id):
    return [device for device in api.request("GET", "/rest/config/devices") if device["deviceID"] != my_id]


def refuse_third_devices(folder, my_id, other_id):
    """A drop that a third device shares is neither sent through nor received from: what is in it goes to that device too."""
    foreign = {device["deviceID"] for device in folder["devices"]} - {my_id, other_id}
    if foreign:
        raise SyncError(f"the drop folder {folder['id']} is shared with {', '.join(sorted(foreign))}, which is no party to "
                        f"it: remove them from it in Syncthing, nothing is sent or received through it until then")


def ensure_drop_folder(api, my_id, other_id):
    """Makes sure the drop of this device and other_id exists and is shared with it, and returns its directory."""
    folder_id = drop_folder_id(my_id, other_id)
    existing = next((folder for folder in api.request("GET", "/rest/config/folders") if folder["id"] == folder_id), None)
    if existing is None:
        path = os.path.join(drops_root(), folder_id)
        for device_id in (my_id, other_id):
            with open_inbox(path, device_id, create=True):
                pass
        api.add_folder(folder_id, DROP_LABEL, path, [my_id, other_id])
        return path
    refuse_third_devices(existing, my_id, other_id)
    api.share_folder_with(existing, other_id)
    return os.path.expanduser(existing["path"])


def share(api, path):
    directory = os.path.abspath(os.path.expanduser(path))
    if not os.path.isdir(directory):
        raise SyncError(f"{directory} is not a directory")
    if any(os.path.expanduser(folder["path"]).rstrip("/") == directory for folder in api.request("GET", "/rest/config/folders")):
        raise SyncError(f"{directory} is shared already")
    my_id = api.my_id()
    token = secrets.token_hex(5)
    folder_id = f"{token[:5]}-{token[5:]}"
    api.add_folder(folder_id, os.path.basename(directory) or directory, directory,
                   [my_id, *(device["deviceID"] for device in other_devices(api, my_id))])
    return folder_id


def join(api, folder_id, path):
    if is_drop(folder_id):
        raise SyncError(f"{folder_id} is a drop, which is taken from the other device of the drop without asking and never joined")
    offer = api.request("GET", "/rest/cluster/pending/folders").get(folder_id)
    # POST /rest/config/folders replaces a folder of the same ID, so a folder that is here already must not get there.
    existing = next((folder for folder in api.request("GET", "/rest/config/folders") if folder["id"] == folder_id), None)
    if existing is not None:
        join_existing(api, existing, offer, path)
        return
    if offer is None:
        raise SyncError(f"no device offers the folder {folder_id}")
    label = next(iter(offer["offeredBy"].values())).get("label", "")
    target = os.path.abspath(os.path.expanduser(path)) if path else os.path.join(sync_root(), sanitize_label(label, folder_id))
    try:
        existing = os.lstat(target)
    except FileNotFoundError:
        existing = None
    except OSError as exc:
        raise SyncError(f"cannot look at {target}: {exc}")
    # lstat: a link is no directory to take, whatever it points at.
    if existing is not None and (not stat.S_ISDIR(existing.st_mode) or os.listdir(target)):
        raise SyncError(f"{target} exists and is not an empty directory; pass another path")
    my_id = api.my_id()
    try:
        os.makedirs(target, exist_ok=True)
    except OSError as exc:
        raise SyncError(f"cannot create {target}: {exc}")
    api.add_folder(folder_id, label or folder_id, target,
                   [my_id, *(device["deviceID"] for device in other_devices(api, my_id))])


def join_existing(api, folder, offer, path):
    """The folder is here already (the same directory was shared from both sides, or this device left it out of an earlier
    share): what is missing is only that it is shared with the devices that offer it. Nothing is missing when no device does."""
    if path and os.path.abspath(os.path.expanduser(path)) != os.path.abspath(os.path.expanduser(folder["path"])):
        raise SyncError(f"the folder {folder['id']} is here already, at {folder['path']}, not at {path}")
    if offer is not None:
        api.share_folder_with(folder, *offer["offeredBy"])


def add_device(api, device_id, name):
    """The one way a device becomes one of this computer's: added with Syncthing's defaults (addresses by discovery), and
    every folder that is not a drop shared with it. An empty name is filled in by Syncthing once the device connects."""
    config = api.request("GET", "/rest/config")
    device = api.request("GET", "/rest/config/defaults/device")
    device.update(deviceID=device_id, name=name)
    api.request("POST", "/rest/config/devices", body=device)
    for folder in config["folders"]:
        if not is_drop(folder["id"]):
            api.share_folder_with(folder, device_id)


def known_device(api, device_id):
    return any(device["deviceID"] == device_id for device in api.request("GET", "/rest/config/devices"))


def accept_device(api, device_id):
    if known_device(api, device_id):
        return
    pending = api.request("GET", "/rest/cluster/pending/devices").get(device_id)
    if pending is None:
        raise SyncError(f"device {device_id} has not asked to connect")
    add_device(api, device_id, device_name(device_id, pending.get("name")))


def pair_device(api, text, name):
    device_id = api.canonical_device_id(text)
    if device_id == api.my_id():
        raise SyncError("that is this computer's own device ID")
    if known_device(api, device_id):
        raise SyncError(f"device {device_id} is one of this computer's devices already")
    add_device(api, device_id, name or "")


def reject_device(api, device_id):
    pending = api.request("GET", "/rest/cluster/pending/devices").get(device_id)
    if pending is None:
        raise SyncError(f"device {device_id} has not asked to connect")
    api.ignore_device(device_id, pending.get("name", ""), pending.get("address", ""))
    api.request("DELETE", "/rest/cluster/pending/devices", query={"device": device_id})


def write_qr(device_id):
    """A QR code of the device ID, as a PNG for the popout to show; the path comes back."""
    directory = vekrona_cli.vekrona_state_dir()
    os.makedirs(directory, exist_ok=True)
    path = os.path.join(directory, "device-id.png")
    staged = f"{path}.{secrets.token_hex(4)}.tmp"
    try:
        result = run_tool("the QR code", ["qrencode", "-t", "PNG", "-s", str(QR_PIXELS_PER_MODULE), "-m", str(QR_QUIET_ZONE_MODULES),
                                         "-o", staged, "--", device_id], capture_output=True, text=True,
                          timeout=PATHS_TIMEOUT_SEC)
        if result.returncode != 0:
            raise SyncError(f"qrencode exited with status {result.returncode}: {result.stderr.strip()}")
        os.replace(staged, path)
    except OSError as exc:
        raise SyncError(f"cannot make the QR code: {exc}")
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(staged)
    return path


def send(api, device_id, files):
    my_id = api.my_id()
    if all(device["deviceID"] != device_id for device in other_devices(api, my_id)):
        raise SyncError(f"device {device_id} is not one of this computer's devices")
    for file in files:
        if not os.path.isfile(file):
            raise SyncError(f"{file} is not a file")
    drop = ensure_drop_folder(api, my_id, device_id)
    with open_inbox(drop, device_id, create=True) as inbox:
        for file in files:
            deliver(file, inbox)


def deliver(file, inbox_fd):
    """The file appears in the inbox whole or not at all: Syncthing ignores the temp name it is copied under."""
    staged = f".syncthing.{secrets.token_hex(4)}.tmp"
    try:
        with open(file, "rb") as source:
            stage_copy(source, inbox_fd, staged)
        try:
            place_without_overwriting(inbox_fd, staged, inbox_fd, os.path.basename(file))
        finally:
            os.unlink(staged, dir_fd=inbox_fd)
    except OSError as exc:
        raise SyncError(f"cannot deliver {file} into the drop folder: {exc}")


# ---- The file chooser portal -----------------------------------------------------------------------------------------

PORTAL_NAME = "org.freedesktop.portal.Desktop"
PORTAL_PATH = "/org/freedesktop/portal/desktop"
PORTAL_CALL_TIMEOUT_MS = 10000
PORTAL_RESPONSE_OK = 0
PORTAL_RESPONSE_CANCELLED = 1


def choose_paths(title, directory):
    """What the user picks in the portal's file chooser: one directory, or any number of files. [] when it is cancelled."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        gi.require_version("GLib", "2.0")
        from gi.repository import Gio, GLib
    except (ImportError, ValueError) as exc:
        raise SyncError(f"the file chooser needs python3-gobject: {exc}")
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    token = f"vekrona_sync_{secrets.token_hex(4)}"
    # The portal answers on a request path it derives from our bus name and token, which is known before the call.
    request_path = (f"/org/freedesktop/portal/desktop/request/"
                    f"{bus.get_unique_name().lstrip(':').replace('.', '_')}/{token}")
    loop = GLib.MainLoop()
    outcome = {}

    def on_response(connection, sender, path, interface, signal, params, user_data):
        outcome["code"], results = params.unpack()
        outcome["uris"] = results.get("uris", [])
        loop.quit()

    def on_name_owner_changed(connection, sender, path, interface, signal, params, user_data):
        if not params.unpack()[2]:
            outcome["error"] = "the desktop portal went away while the file chooser was open"
            loop.quit()

    bus.signal_subscribe(PORTAL_NAME, "org.freedesktop.portal.Request", "Response", request_path, None,
                         Gio.DBusSignalFlags.NONE, on_response, None)
    bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged", "/org/freedesktop/DBus",
                         PORTAL_NAME, Gio.DBusSignalFlags.NONE, on_name_owner_changed, None)
    options = {"handle_token": GLib.Variant("s", token), "directory": GLib.Variant("b", directory),
               "multiple": GLib.Variant("b", not directory)}
    try:
        bus.call_sync(PORTAL_NAME, PORTAL_PATH, "org.freedesktop.portal.FileChooser", "OpenFile",
                      GLib.Variant("(ssa{sv})", ("", title, options)), GLib.VariantType("(o)"),
                      Gio.DBusCallFlags.NONE, PORTAL_CALL_TIMEOUT_MS, None)
    except GLib.Error as exc:
        raise SyncError(f"cannot open the file chooser: {exc.message}")
    loop.run()
    if "error" in outcome:
        raise SyncError(outcome["error"])
    if outcome["code"] == PORTAL_RESPONSE_CANCELLED:
        return []
    if outcome["code"] != PORTAL_RESPONSE_OK:
        raise SyncError(f"the file chooser ended with the portal's response {outcome['code']}")
    paths = [Gio.File.new_for_uri(uri).get_path() for uri in outcome["uris"]]
    if None in paths:
        raise SyncError(f"the file chooser returned something that is not a local path: {outcome['uris']}")
    return paths


# ---- watch -----------------------------------------------------------------------------------------------------------

def finished_drops(events):
    """The drop folders in which a file finished syncing, from a batch of events."""
    return {event["data"]["folder"] for event in events
            if event["type"] == "ItemFinished" and event["data"]["error"] is None and is_drop(event["data"]["folder"])}


def matters(event):
    """Every file of every folder finishes with an ItemFinished, and only those of a drop need a look."""
    return event["type"] != "ItemFinished" or is_drop(event["data"]["folder"])


class Watcher:
    def __init__(self, store, notifier, report):
        self.store = store
        self.notifier = notifier
        self.report = report
        self.api = None
        self.snapshot = None
        self.notified = set()
        self.reported = set()
        self.ignored_offers = set()

    def follow(self, api):
        """Follows Syncthing until it stops answering (Unreachable)."""
        self.api = api
        my_id = api.my_id()
        latest = api.latest_event_id()
        self.snapshot = read_snapshot(api, my_id)
        self.refresh(scan_all=True, finished=set())
        while True:
            batch = api.events(latest)
            if not batch:
                continue
            # The IDs of one subscription follow each other, so a jump means events were dropped: look at everything.
            gap = batch[0]["id"] != latest + 1
            latest = batch[-1]["id"]
            if gap or any(event["type"] in REREAD_EVENTS for event in batch):
                self.snapshot = read_snapshot(api, my_id)
                self.refresh(scan_all=gap, finished=finished_drops(batch))
            elif any(matters(event) for event in batch):
                for event in batch:
                    apply_event(self.snapshot, event)
                self.refresh(scan_all=False, finished=finished_drops(batch))

    def refresh(self, scan_all, finished):
        self.accept_drops()
        arrivals = self.receive(scan_all, finished)
        view = assemble(self.snapshot)
        self.store.publish(view, arrivals)
        self.notify(view, arrivals)

    def problem(self, message):
        """Reports a problem that stays until someone fixes it, once, not at every event."""
        if message not in self.reported:
            self.reported.add(message)
            self.report(message)

    def accept_drops(self):
        snapshot = self.snapshot
        for folder_id, entry in snapshot.pending_folders.items():
            if not is_drop(folder_id):
                continue
            for device_id in entry["offeredBy"]:
                if not auto_accepts(folder_id, device_id, snapshot.my_id):
                    self.ignore_offer(folder_id, device_id)
                    continue
                try:
                    ensure_drop_folder(self.api, snapshot.my_id, device_id)
                except Unreachable:
                    raise
                except SyncError as exc:
                    self.problem(str(exc))

    def ignore_offer(self, folder_id, device_id):
        """A drop that no other party to it offers can only be a device trying to get files from this one or into it."""
        if (folder_id, device_id) not in self.ignored_offers:
            self.ignored_offers.add((folder_id, device_id))
            vekrona_cli.print_failure(PROG, f"ignoring the offer of the drop {folder_id} by the device {device_id}, "
                                            f"which is not a party to it")

    def receive(self, scan_all, finished):
        snapshot = self.snapshot
        names = {device["deviceID"]: device_name(device["deviceID"], device.get("name")) for device in snapshot.devices}
        arrivals = []
        for folder in snapshot.folders:
            partner = drop_partner(folder["id"], snapshot.my_id)
            if partner is None or not (scan_all or folder["id"] in finished):
                continue
            try:
                refuse_third_devices(folder, snapshot.my_id, partner)
                received, failures = receive(os.path.expanduser(folder["path"]), snapshot.my_id,
                                             names.get(partner, short_code(partner)))
            except SyncError as exc:
                self.problem(str(exc))
                continue
            arrivals += received
            for failure in failures:
                self.report(failure)
        return arrivals

    def notify(self, view, arrivals):
        pending = {("device", device["id"]): device for device in view["pendingDevices"]}
        offers = {("offer", offer["folder"], offer["device"]): offer for offer in view["offers"]}
        fresh = (pending.keys() | offers.keys()) - self.notified
        self.notified = pending.keys() | offers.keys()
        api = self.api
        for key in sorted(fresh):
            if key in pending:
                device = pending[key]
                self.notifier.pairing(device, lambda device=device: accept_device(api, device["id"]),
                                      lambda device=device: reject_device(api, device["id"]))
            else:
                offer = offers[key]
                self.notifier.offer(offer, lambda offer=offer: join(api, offer["folder"], None))
        for arrival in arrivals:
            self.notifier.arrival(arrival)


# ---- Command line ----------------------------------------------------------------------------------------------------

def command_id(args):
    print(Syncthing.from_config().my_id())


def command_share(args):
    path = args.path or next(iter(choose_paths("Share a folder", directory=True)), None)
    if path is not None:
        print(share(Syncthing.from_config(), path))


def command_join(args):
    join(Syncthing.from_config(), args.folder, args.path)


def command_qr(args):
    print(write_qr(Syncthing.from_config().my_id()))


def command_pair(args):
    pair_device(Syncthing.from_config(), args.device, args.name)


def command_accept(args):
    accept_device(Syncthing.from_config(), args.device)


def command_reject(args):
    reject_device(Syncthing.from_config(), args.device)


def command_send(args):
    files = args.files or choose_paths("Send files", directory=False)
    if files:
        send(Syncthing.from_config(), args.device, files)


def report_failure(message):
    vekrona_cli.surface_failure(PROG, message, __file__)


def command_nearby(args):
    current = StateStore(report_failure).read()
    for device_id in answering_nearby([] if current is None else current["nearby"]):
        print(device_id)


def command_seen(args):
    StateStore(report_failure).mark_seen()


def command_offline(args):
    StateStore(report_failure).publish(offline_view(), [])


def command_watch(args):
    watcher = Watcher(StateStore(report_failure), DesktopNotifier(report_failure), report_failure)
    try:
        watcher.follow(Syncthing.from_config())
    except Unreachable as exc:
        # The unit's ExecStopPost writes the offline sync.json, and systemd starts the watcher again after a growing delay.
        vekrona_cli.print_failure(PROG, str(exc))
        sys.exit(EXIT_UNREACHABLE)
    except ConfigError as exc:
        report_failure(str(exc))
        sys.exit(EXIT_CONFIG)


def parse_args(argv):
    parser = argparse.ArgumentParser(prog=PROG, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    for name, handler, arguments in (
            ("id", command_id, []),
            ("qr", command_qr, []),
            ("pair", command_pair, [("device", {}), ("name", {"nargs": "?"})]),
            ("share", command_share, [("path", {"nargs": "?"})]),
            ("join", command_join, [("folder", {}), ("path", {"nargs": "?"})]),
            ("accept", command_accept, [("device", {"type": device_id_arg})]),
            ("reject", command_reject, [("device", {"type": device_id_arg})]),
            ("send", command_send, [("device", {"type": device_id_arg}), ("files", {"nargs": "*"})]),
            ("nearby", command_nearby, []),
            ("seen", command_seen, []),
            ("offline", command_offline, []),
            ("watch", command_watch, [])):
        subparser = commands.add_parser(name)
        subparser.set_defaults(handler=handler)
        for argument, options in arguments:
            subparser.add_argument(argument, **options)
    return parser.parse_args(argv)


def main():
    args = parse_args(sys.argv[1:])
    try:
        args.handler(args)
    except SyncError as exc:
        # The caller shows or records this: the shell shows stderr, and a watcher that exits fails its unit, which is recorded.
        vekrona_cli.exit_unrecorded(PROG, str(exc))


if __name__ == "__main__":
    main()
