#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$ROOT/lib/common.sh"

STATE_DIR="$(vekrona_state_dir)"
STATE_FILE="$(vekrona_theme_name_file)"
ACTIVE_THEME_FILE="$(vekrona_active_theme_file)"

usage() {
  printf 'usage: %s dark|light|next|list\n' "$(basename "$0")" >&2
  exit 1
}

MODES=(dark light)

current_theme() {
  [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE"
}

ROLLBACK_ON_EXIT=0
MODE_BACKUP=""
ACTIVE_THEME_BACKUP=""

# Replace <dest> by a copy of <source> with one rename, so the shell, which watches the file, never reads it half written.
replace_file_from() {
  local source="$1" dest="$2" tmp
  tmp="$(mktemp "$(dirname "$dest")/.$(basename "$dest").restore.XXXXXX")"
  cp "$source" "$tmp"
  mv "$tmp" "$dest"
}

# Put the files back, then re-render so GTK, Qt, Firefox, Sway and the shell agree with the recorded mode again.
# With no usable recorded mode (none yet, or a legacy value stage 50 would migrate) the mode goes back to dark,
# stage 50's default, so the files and the desktop still agree. A failing re-render is reported: the desktop
# would be left half-themed.
rollback() {
  local previous=dark recorded
  if [[ -n "$MODE_BACKUP" ]]; then
    recorded="$(cat "$MODE_BACKUP")"
    [[ "$recorded" == dark || "$recorded" == light ]] && previous="$recorded"
  fi
  printf '%s\n' "$previous" > "$STATE_FILE.tmp.$$"
  mv "$STATE_FILE.tmp.$$" "$STATE_FILE"
  if [[ -n "$ACTIVE_THEME_BACKUP" ]]; then
    replace_file_from "$ACTIVE_THEME_BACKUP" "$ACTIVE_THEME_FILE"
  else
    rm -f "$ACTIVE_THEME_FILE"
  fi
  "$ROOT/bin/vekrona-render-theme" || echo "vekrona-theme: re-rendering '$previous' after the failure failed; run 'vekrona-theme $previous'" >&2
}

cleanup() {
  [[ "$ROLLBACK_ON_EXIT" == "1" ]] && rollback
  [[ -n "$MODE_BACKUP" ]] && rm -f "$MODE_BACKUP"
  [[ -n "$ACTIVE_THEME_BACKUP" ]] && rm -f "$ACTIVE_THEME_BACKUP"
}

backup_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local backup
  backup="$(mktemp "$STATE_DIR/.$(basename "$file").backup.XXXXXX")"
  cp "$file" "$backup"
  printf '%s' "$backup"
}

apply_theme() {
  local mode="$1"

  mkdir -p "$STATE_DIR"
  trap cleanup EXIT
  MODE_BACKUP="$(backup_file "$STATE_FILE")"
  ACTIVE_THEME_BACKUP="$(backup_file "$ACTIVE_THEME_FILE")"
  ROLLBACK_ON_EXIT=1
  printf '%s\n' "$mode" > "$STATE_FILE"

  "$ROOT/bin/vekrona-render-theme"

  ROLLBACK_ON_EXIT=0
  echo "theme: $mode"
}

cmd="${1:-}"
[[ -n "$cmd" ]] || usage

case "$cmd" in
  list)
    printf '%s\n' "${MODES[@]}"
    ;;
  next)
    case "$(current_theme || true)" in
      dark) apply_theme light ;;
      *) apply_theme dark ;;
    esac
    ;;
  dark | light)
    apply_theme "$cmd"
    ;;
  *)
    usage
    ;;
esac
