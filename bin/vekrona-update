#!/usr/bin/env bash
# Updates the whole computer now: starts vekrona-update-now.service, which runs libexec/vekrona-update-apply --online as
# root (polkit lets a local wheel user start it, so there is no sudo), and shows its output until it ends. Exits with the
# unit's result.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$ROOT/lib/common.sh"

[[ $EUID -ne 0 ]] || die "run as your user, not root"

unit=vekrona-update-now.service
sentinel="finished $$ $RANDOM $RANDOM"
status_file="$(mktemp)"

# The journal follower stops at the sentinel, which this script logs after the unit ended, so the unit's last lines
# are shown before it does.
exec {follow}< <(exec journalctl --follow --since now --output cat _SYSTEMD_UNIT="$unit" + SYSLOG_IDENTIFIER=vekrona-update-client)
follower=$!
cleanup() {
  kill "$follower" 2>/dev/null || true
  rm -f "$status_file"
}
trap cleanup EXIT

(
  status=0
  systemctl start --wait "$unit" || status=$?
  echo "$status" >"$status_file"
  logger --tag vekrona-update-client -- "$sentinel"
) &
starter=$!

seen=0
while IFS= read -r line <&"$follow"; do
  if [[ "$line" == "$sentinel" ]]; then seen=1; break; fi
  printf '%s\n' "$line"
done
wait "$starter"
[[ $seen -eq 1 ]] || die "the journal follower ended before $unit finished"
exit "$(<"$status_file")"
