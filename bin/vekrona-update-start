#!/usr/bin/env bash
# Starts a vekrona update unit without waiting for it. A polkit denial or a missing unit would otherwise be
# lost behind a launcher or a notification action, so a failure is recorded as an error, which the robot shows.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$ROOT/lib/common.sh"

[[ $# -eq 1 && "$1" == vekrona-update-*.service ]] || {
  printf 'usage: %s vekrona-update-UNIT.service\n' "$(basename "$0")" >&2
  exit 2
}
unit="$1"

if ! output="$(systemctl start --no-block "$unit" 2>&1)"; then
  die "vekrona update: systemctl start $unit failed: $output"
fi
