#!/usr/bin/env python3
"""A VPN from WireGuard configurations, with a kill switch: the commands behind the bar's VPN popout.

Each configuration is a NetworkManager connection named "vekrona-vpn/<vendor>/<country>/<name>", the vendor being mullvad,
proton or other. Connecting arms the kill switch (an nftables table that rejects whatever does not leave through the tunnel, so
programs fail at once instead of waiting) and then brings the tunnel up. The kill switch stays until "off": a tunnel that drops
leaves traffic blocked. The changes that need root run as vekrona-vpn-apply@<operation>-<uid>.service, which this command starts;
the arguments reach it through a file in /run/user/<uid>/vekrona-vpn/. Commands that change something wait for each other (a lock
in that directory), and the helper holds a lock of its own, so a connect and an off never interleave. status and list never wait.

The keys (of each configuration, and the Mullvad device), the Mullvad account number and the Proton session and seed live in the keyring (gnome-keyring, through
secret-tool, see lib/vekrona_secrets.py). Only the commands that need a key touch it; status and list never do. A key goes to the
helper in its request file and from there to nmcli on stdin, so NetworkManager keeps none of them.

  status                 one JSON object on stdout:
                           {"schema":1,"armed":bool,"tunnel":"down"|"activating"|"up",
                            "connection":null|{"uuid":str,"vendor":"mullvad"|"proton"|"other","country":"NL","name":str},
                            "mullvad":{"logged_in":bool},"proton":{"logged_in":bool,"netshield":0|1|2}}
                         connection is the one in use, or the one the kill switch was armed for while its tunnel is down
  list                   one JSON object on stdout:
                           {"schema":1,"vendors":[{"id":"mullvad"|"proton"|"other","label":str,
                             "countries":[{"code":"NL"|"??","name":str,"configs":[{"uuid":str,"name":str}]}]}]}
                         Mullvad's countries come from its relay list and Proton's from its catalog (cached by `proton login` and
                         `connect`); both have "configs":[]: connect to them by country. The relay list is asked for again when
                         it is older than a day and Mullvad is logged in
  connect UUID           arm the kill switch and bring that configuration up (its key comes from the keyring, which may prompt)
  connect mullvad CC     the same for a random Mullvad relay of the country CC (a code, or a name such as Netherlands). When CC is
                         not a code, the country it was taken for is printed on stderr: "using Netherlands (NL)"
  connect proton CC|free the same for a Proton server: CC is a country code (the usable server with the lowest score), free the
                         fastest free server. A fresh certificate is requested for the key, and renewed while the tunnel is up
  off                    take the tunnel down, then remove the kill switch
  import --vendor other [FILE...]
                         add the WireGuard configurations FILE... (no FILE: the file chooser, several .conf files). The country
                         is the first two-letter token of the file name that is an ISO country ("NL-792.conf"), else "??". The
                         keys go to the keyring
  forget UUID            remove a configuration and its key from the keyring
  mullvad login          read the Mullvad account number from stdin (a terminal prompt without echo), register a WireGuard
                         device with Mullvad, and keep the number and the device's key in the keyring. A device it replaces is
                         removed from the account
  mullvad logout         remove this device from the Mullvad account, forget the Mullvad connections and clear the keyring of them
  proton login           start a sign-in: the code is shown in a notification and printed on stdout, and the browser opens
                         account.protonvpn.com/tv. A transient unit waits up to ten minutes for the code and keeps the session
                         (the session and the seed go to the keyring; the catalog to the cache). One sign-in waits at a time
  proton logout          end the Proton session, forget the Proton connections and clear the keyring and the catalog
  proton netshield 0|1|2 NetShield level for the next connect: 0 off, 1 malware, 2 malware, ads and trackers
  seal                   move the keys that NetworkManager's keyfiles still hold into the keyring and take them out of the keyfiles
                         (connect does this first when there is one; the install does it once)

A failure exits non-zero with one line on stderr. The shell also watches /run/vekrona-vpn/state.json (root-owned:
{"schema":1,"armed":bool,"uuid":str|null}) and runs `status` again when it changes, or when `nmcli monitor` reports a change."""
import argparse
import contextlib
import dataclasses
import json
import os
import sys
import time
from datetime import datetime, timezone
from typing import Dict, List, Optional, Tuple

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import vekrona_cli
import vekrona_countries
import vekrona_mullvad as mullvad
import vekrona_proton as proton
import vekrona_secrets as secrets
import vekrona_vpn as vpn
from vekrona_vpn import VpnError

PROG = "vekrona-vpn"
SCRIPT = os.path.realpath(__file__)
IMPORT_TITLE = "Import WireGuard configurations"
PROTON_LOGIN_UNIT = "vekrona-vpn-proton-login"  # the transient unit that waits for the code of a sign-in
# The transient timers that renew the certificate of a Proton connection are named RENEW_UNIT_PREFIX + the time they fire (below).
LOGIN_NAME = "proton-login.json"  # in the user's runtime directory: the selector of the sign-in the unit waits for
NETSHIELD_DEFAULT = 1  # Malware: NetShield blocks malware (the level the Proton apps start with)


def relay_cache():
    return os.path.join(vekrona_cli.xdg_dir("XDG_CACHE_HOME", (".cache",)), "vekrona", "vpn-relays.json")


def proton_catalog_path():
    return os.path.join(vekrona_cli.xdg_dir("XDG_CACHE_HOME", (".cache",)), "vekrona", "vpn-proton.json")


def settings_path():
    return os.path.join(vekrona_cli.vekrona_config_dir(), "vpn.json")


def helper_failure(uid, nonce, exc):
    """The error for a `systemctl start` that failed with `exc`: the line the helper left for this request when it left one, else
    systemctl's own error, with what is known of the helper (polkit refused the start, the unit ran into its timeout, ...)."""
    try:
        receipt = vpn.receipt_of(uid, nonce)
    except VpnError as unreadable:
        return VpnError(f"{exc}; and the helper's message cannot be read: {unreadable}")
    if receipt is None:
        return VpnError(f"{exc} (the helper did not serve this request)")
    return VpnError(receipt.failure or f"{exc} (the helper did serve this request)")


def start_helper(op, uid, nonce):
    """Start the unit of `op` for the request handed over with `nonce`, and check that the helper served that very request."""
    unit = vpn.APPLY_UNIT % vpn.instance_name(op, uid)
    try:
        vpn.run(["systemctl", "--no-ask-password", "start", unit], timeout=vpn.APPLY_WAIT_SEC)
    except VpnError as exc:
        raise helper_failure(uid, nonce, exc)
    vpn.require_served(uid, op, nonce)


def run_apply(op, request):
    """Do `op` as root: hand over the request (None: the operation takes none), start the unit, wait for it, and check that the
    helper served this request and not one of an interrupted call whose job this start merged into. Calls queue behind each
    other. A failure is reported with the line the helper left for this request."""
    uid = os.getuid()
    with vpn.handed_over(uid, request) as nonce:
        start_helper(op, uid, nonce)


def run_held(uid, op, request):
    """run_apply for a caller that holds the user's lock already (vpn.user_lock), so that several operations go under one lock."""
    with vpn.hand_over(uid, request) as nonce:
        start_helper(op, uid, nonce)


def status_connections(connections):
    """The connections as `status` names them. A generated Proton connection is "signed-in" in its id: the name shown is that of the
    catalog's server whose entry address is the connection's endpoint, which is how the connection was made. A catalog that cannot be
    read is said on stderr and the id's name is shown."""
    if not any(connection.vendor == vpn.VENDOR_PROTON and connection.is_active and connection.name == vpn.PROTON_GENERATED_NAME
               for connection in connections):
        return connections
    try:
        catalog = read_catalog()
    except VpnError as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        catalog = None
    named = []
    for connection in connections:
        if connection.vendor == vpn.VENDOR_PROTON and connection.is_active and connection.name == vpn.PROTON_GENERATED_NAME and catalog:
            address = vpn.nm_endpoint(connection.uuid).address
            logical = next((logical for logical in catalog["logicals"] for server in logical["servers"] if server["entry_ip"] == address), None)
            if logical is not None:
                name = logical["name"] + ("" if proton.has_ipv6(logical) else proton.IPV4_ONLY)
                connection = dataclasses.replace(connection, full_id=str(vpn.ConnectionId(vpn.VENDOR_PROTON, connection.country, name)))
        named.append(connection)
    return named


def command_status(args):
    print(json.dumps(vpn.status_json(status_connections(vpn.nm_connections()), vpn.read_state(), proton_status())))


def mullvad_countries(connections):
    """Mullvad's countries (code -> name) from the relay list cache, refreshed when it is old and there is an account. A list that
    cannot be had is said on stderr and leaves Mullvad without countries."""
    cache = relay_cache()
    try:
        if any(connection.vendor == vpn.VENDOR_MULLVAD for connection in connections):
            relays = mullvad.current_relays(cache)
        else:
            relays = mullvad.read_cache(cache)
    except VpnError as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return mullvad.NO_RELAYS["names"]
    return (relays or mullvad.NO_RELAYS)["names"]


def proton_countries() -> Dict[str, str]:
    """Proton's countries (code -> name) from the catalog cache, which only a sign-in or a connect writes: nothing is asked of the network.
    A cache that cannot be used is said on stderr and leaves Proton without countries."""
    try:
        catalog = vpn.read_cache(proton_catalog_path(), proton.validate_catalog)
    except VpnError as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return {}
    return {} if catalog is None else proton.countries_of(catalog)


def catalog_countries(connections) -> Dict[str, Dict[str, str]]:
    """The countries of each vendor that has a catalog (vendor -> code -> name)."""
    return {vpn.VENDOR_MULLVAD: mullvad_countries(connections), vpn.VENDOR_PROTON: proton_countries()}


def command_list(args):
    connections = vpn.nm_connections()
    print(json.dumps(vpn.list_json(connections, catalog_countries(connections))))


def mullvad_relay_for(query):
    relay_list = mullvad.current_relays(relay_cache())
    try:
        code, exact = vekrona_countries.resolve_country(query, relay_list["names"])
    except vekrona_countries.CountryError as exc:
        raise VpnError(str(exc))
    if not exact:
        # A name or a start of one is a guess (swe is Sweden): say which country the tunnel will be in.
        print(f"{PROG}: using {vekrona_countries.display_name(code, relay_list['names'])} ({code.upper()})", file=sys.stderr)
    return mullvad.select_relay(relay_list, code)


def connection_of(uuid: str) -> vpn.Connection:
    for connection in vpn.nm_connections():
        if connection.uuid == uuid:
            return connection
    raise VpnError("not a connection of vekrona-vpn")


def device_item() -> Optional[dict]:
    """The keyring's Mullvad device (key, addresses and, when it was registered by this tool, its id at Mullvad), or None."""
    return secrets.lookup_optional(secrets.MULLVAD_DEVICE, secrets.MULLVAD_DEVICE_ID)


def logged_in_device() -> dict:
    item = device_item()
    if item is None:
        raise VpnError("Mullvad is not logged in")
    return item


def device_of_item(item: dict) -> vpn.Device:
    """The checked device of a keyring item: its key and addresses, which is all a connection takes."""
    return vpn.validate_device({field: item.get(field) for field in vpn.DEVICE_FIELDS})


def connection_keys(connection: vpn.Connection) -> dict:
    """The keys of a connection, from the keyring: a Mullvad connection uses the device's key, any other its own keys."""
    if connection.vendor == vpn.VENDOR_MULLVAD:
        return {"private_key": device_of_item(logged_in_device()).private_key}
    return secrets.lookup(secrets.CONFIG_KEY, connection.full_id)


def command_connect(args):
    if args.target == vpn.VENDOR_MULLVAD:
        if args.country is None:
            raise VpnError("connect mullvad needs a country")
        seal_pending()
        device = device_of_item(logged_in_device())
        relay = mullvad_relay_for(args.country)
        run_apply("connect", {"vendor": vpn.VENDOR_MULLVAD, "relay": dataclasses.asdict(relay), "device": dataclasses.asdict(device)})
    elif args.target == vpn.VENDOR_PROTON:
        if args.country is None:
            raise VpnError("connect proton needs a country code or free")
        connect_proton(args.country)
    elif args.country is not None:
        raise VpnError("connect takes a uuid, or mullvad or proton and a country")
    else:
        uuid = vpn.require_uuid(args.target)
        connection = connection_of(uuid)
        if connection.vendor == vpn.VENDOR_PROTON:
            raise VpnError("Proton connections are made by country: connect proton CC, or connect proton free")
        # Checked before any keyring access, so that a refused connect neither prompts nor changes anything (the helper checks it too).
        vpn.require_bound_to_tunnel(uuid, connection.full_id)
        seal_pending()
        run_apply("connect", {"uuid": uuid, "keys": connection_keys(connection)})


def command_seal(args):
    seal_pending()


def seal_pending() -> None:
    """Move the keys that NetworkManager's keyfiles still hold into the keyring and out of the keyfiles. The user's lock is held from
    the export to the strip, so no other call of this user interleaves. The strip always runs after the export: it takes out of
    NetworkManager the keys that were stored, and the helper removes the export with it. A key that cannot be checked stays where it
    is: the others are stored and stripped, and the error names each connection that kept its key. Nothing runs as root unless a
    connection holds one, so a sealed machine costs one nmcli call per connection."""
    if not any(vpn.key_in_keyfile(vpn.nm_key_flags(connection.uuid)) for connection in vpn.nm_connections()):
        return
    uid = os.getuid()
    failures: List[str] = []
    with vpn.user_lock(uid):
        run_held(uid, "seal", {"phase": "export"})
        stripped: List[str] = []
        pending: Optional[VpnError] = None
        try:
            items, checked, failures = sealed_items(read_sealed(uid))
            secrets.store_all(items)
            stripped = checked
        except VpnError as exc:
            pending = exc
        strip_after(uid, stripped, pending)
    if failures:
        raise VpnError("these connections keep their keys in their keyfiles: " + "; ".join(failures))


def strip_after(uid: int, stripped: List[str], pending: Optional[VpnError]) -> None:
    """The strip that ends a seal, run whatever happened before it (`pending`). When both fail, the error carries both messages."""
    try:
        run_held(uid, "seal", {"phase": "strip", "uuids": stripped})
    except VpnError as strip_error:
        if pending is None:
            raise
        raise VpnError("%s; and the strip that followed it failed too: %s" % (pending, strip_error)) from pending
    if pending is not None:
        raise pending


def read_sealed(uid: int) -> List[dict]:
    """The keys the helper handed over in its file for the user (read, not removed)."""
    path = vpn.sealed_path(uid)
    with vpn.files_reported("read " + path):
        with open(path) as handle:
            text = handle.read()
    try:
        entries = json.loads(text)
    except vpn.JSON_ERRORS:
        raise VpnError("the keys the helper handed over are not JSON")
    if not isinstance(entries, list):
        raise VpnError("the keys the helper handed over are not a list")
    return entries


def sealed_item(entry: dict, mullvad_missing: bool) -> Optional[secrets.Item]:
    """The keyring item of one key the helper handed over, checked. None when there is nothing to store: a profile whose keyfile holds
    no key (the strip still clears its flag), or a Mullvad key when the keyring has a device already."""
    if entry["private_key"] == "":
        return None
    if entry["vendor"] == vpn.VENDOR_MULLVAD:
        if not mullvad_missing:
            return None
        device = vpn.validate_device({field: entry[field] for field in vpn.DEVICE_FIELDS})
        return (secrets.MULLVAD_DEVICE, secrets.MULLVAD_DEVICE_ID, dataclasses.asdict(device))
    keys = vpn.validate_keys({field: entry[field] for field in vpn.KEY_FIELDS if field in entry})
    return (secrets.CONFIG_KEY, entry["id"], keys)


def sealed_items(entries: List[dict]) -> Tuple[List[secrets.Item], List[str], List[str]]:
    """(keyring items, uuids of the connections whose keys are checked, one failure per connection that is not): each entry is
    checked by itself, so a bad one does not stop the others. The Mullvad keys are one device: the first of them, and only while the
    keyring has none."""
    items, uuids, failures = [], [], []
    mullvad_missing = device_item() is None
    for position, entry in enumerate(entries, 1):
        name = entry.get("id") if isinstance(entry, dict) and isinstance(entry.get("id"), str) else "entry %d" % position
        try:
            item = sealed_item(entry, mullvad_missing)
            uuid = vpn.require_uuid(entry["uuid"])
        except VpnError as exc:
            failures.append("%s (%s)" % (name, exc))
            continue
        except (KeyError, TypeError, AttributeError):
            failures.append("%s (the helper handed over a key in a layout this tool does not know)" % name)
            continue
        if item is not None:
            items.append(item)
            mullvad_missing = mullvad_missing and item[0] != secrets.MULLVAD_DEVICE
        uuids.append(uuid)
    return items, uuids, failures


def command_forget(args):
    connection = connection_of(vpn.require_uuid(args.uuid))
    run_apply("forget", {"uuid": connection.uuid})
    if connection.vendor == vpn.VENDOR_PROTON and not proton_connection_active():
        stop_renewal()
    if connection.vendor != vpn.VENDOR_MULLVAD:
        try:
            secrets.clear(secrets.CONFIG_KEY, connection.full_id)
        except VpnError as exc:
            raise VpnError("the connection is forgotten, but its key is still in the keyring; remove it with secret-tool clear "
                           "application vekrona-vpn kind config-key id %s (%s)" % (connection.full_id, exc))


def read_conf_file(path):
    """({"file", "text"}, the checked configuration) of a file that parses; the error names the file, and never what is in it."""
    name = os.path.basename(path)
    with vpn.labelled(name):
        try:
            with open(path, "rb") as handle:
                raw = handle.read(vpn.MAX_CONF_BYTES + 1)
        except OSError as exc:
            raise VpnError(exc.strerror)
        text, conf = vpn.check_conf(raw)
    return {"file": name, "text": text}, conf


def keys_of(conf: vpn.WgConf) -> dict:
    keys = {"private_key": conf.private_key}
    if conf.preshared_key is not None:
        keys["preshared_key"] = conf.preshared_key
    return keys


def command_import(args):
    try:
        paths = args.files or vekrona_cli.choose_paths(IMPORT_TITLE, directory=False)
    except vekrona_cli.PortalError as exc:
        raise VpnError(str(exc))
    if not paths:
        return
    files = [read_conf_file(path) for path in paths]
    vpn.require_distinct_ids([(vpn.import_id(args.vendor, entry["file"]), entry["file"]) for entry, _ in files])
    items = [(secrets.CONFIG_KEY, str(vpn.import_id(args.vendor, entry["file"])), keys_of(conf)) for entry, conf in files]
    previous = secrets.store_all(items)
    try:
        run_apply("import", {"vendor": args.vendor, "files": [entry for entry, _ in files]})
    except VpnError as exc:
        raise undo_keyring(exc, previous)


def command_off(args):
    run_apply("off", None)
    # A renewal timer exists only for a Proton connection, and that connection stays in NetworkManager until it is forgotten: when there is
    # none, there is no timer to stop, and this costs no systemctl call.
    if any(connection.vendor == vpn.VENDOR_PROTON for connection in vpn.nm_connections()):
        stop_renewal()


def undo_keyring(exc: VpnError, previous: List[secrets.Previous]) -> VpnError:
    """The error for an operation that failed with `exc` after its keys were stored: the keyring is put back as it was."""
    problem = secrets.restore(previous)
    return exc if problem is None else VpnError("%s; and the keyring could not be put back: %s" % (exc, problem))


def undo_login(exc: VpnError, token: str, registered, previous: List[secrets.Previous]) -> VpnError:
    """The error for a login that failed with `exc`, after the keyring is put back (`previous`) and the new device is removed from
    the account: its key is nowhere else, so it is of no use. Each step's failure is said too."""
    problems = []
    problem = secrets.restore(previous)
    if problem is not None:
        problems.append("the keyring could not be put back: %s" % problem)
    try:
        mullvad.revoke_device(token, registered.id)
    except VpnError as revoke:
        problems.append("the new device %s stays on the account: %s" % (registered.name, revoke))
    return VpnError("; ".join([str(exc), *problems])) if problems else exc


def account_number(item: dict) -> str:
    number = item.get("number")
    if not isinstance(number, str):
        raise VpnError("the keyring's Mullvad account holds no number")
    return number


def revoke_stored(token: str, item: dict) -> None:
    """Remove the device of a keyring item from the Mullvad account: by the id it was registered with or, for an item stored before ids
    were kept (a migrated key), by the public key of its private key. A device the account does not list is gone already."""
    device_id = item.get("device_id")
    if device_id is None:
        public_key = mullvad.public_key_of(device_of_item(item).private_key)
        ids = [device.get("id") for device in mullvad.list_devices(token)
               if isinstance(device, dict) and device.get("pubkey") == public_key]
        if not ids:
            return
        device_id = ids[0]
    if not isinstance(device_id, str):
        raise VpnError("the keyring's Mullvad device has no usable id")
    mullvad.revoke_device(token, device_id)


def command_mullvad_login(args):
    account = mullvad.read_account()
    old_device = device_item()
    relay = mullvad.any_relay(mullvad.current_relays(relay_cache()))
    token = mullvad.api_token(account)
    private_key, public_key = mullvad.new_key_pair()
    registered = mullvad.register_device(token, private_key, public_key)
    previous = []
    try:
        previous = secrets.store_all([
            (secrets.MULLVAD_ACCOUNT, secrets.MULLVAD_ACCOUNT_ID, {"number": account}),
            (secrets.MULLVAD_DEVICE, secrets.MULLVAD_DEVICE_ID, {**dataclasses.asdict(registered.device), "device_id": registered.id}),
        ])
        run_apply("login", {"device": dataclasses.asdict(registered.device), "relay": dataclasses.asdict(relay)})
    except VpnError as exc:
        raise undo_login(exc, token, registered, previous)
    if old_device is not None:
        try:
            revoke_stored(token, old_device)
        except VpnError as exc:
            raise VpnError("logged in as %s, but the device before it could not be removed: %s" % (registered.name, exc))


def command_mullvad_logout(args):
    """Remove this device from the Mullvad account, forget the Mullvad connections and clear the keyring of the account and the device.
    The device goes first: if it cannot be removed, nothing else changes. Without an account item (an install from before the keyring
    held it) the number is asked for, as login does."""
    seal_pending()
    device = device_item()
    if device is not None:
        account = secrets.lookup_optional(secrets.MULLVAD_ACCOUNT, secrets.MULLVAD_ACCOUNT_ID)
        number = account_number(account) if account is not None else mullvad.read_account()
        revoke_stored(mullvad.api_token(number), device)
        secrets.clear(secrets.MULLVAD_DEVICE, secrets.MULLVAD_DEVICE_ID)
    for connection in vpn.nm_connections():
        if connection.vendor == vpn.VENDOR_MULLVAD:
            run_apply("forget", {"uuid": connection.uuid})
    secrets.clear(secrets.MULLVAD_ACCOUNT, secrets.MULLVAD_ACCOUNT_ID)


# ---- Proton: the sign-in, the session, the certificate and its renewal -------------------------------------------------

RENEW_UNIT_PREFIX = "vekrona-vpn-proton-renew-"  # one timer per arming, named after the time it fires
RENEW_ARM_DELAY_SEC = 60  # a renewal that is due in the past is armed this far ahead
RENEW_RETRY_SEC = 30 * 60  # the retry after a failed renewal comes this long after it
RENEW_EXPIRY_MARGIN_SEC = 5 * 60  # ... or this long before the certificate expires, when that is sooner
CATALOG_MAX_AGE_SEC = 60 * 60  # a connect uses the catalog cache while it is younger than this, without asking Proton


def self_command(*args):
    """The argv that runs this tool with `args`, for a transient unit: the interpreter that runs it and its path."""
    return [sys.executable, SCRIPT, *args]


def utc_text(when: int) -> str:
    return datetime.fromtimestamp(when, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")


def proton_signed_in() -> bool:
    """Whether a sign-in is kept: its catalog is, and signing out removes both."""
    return os.path.exists(proton_catalog_path())


def proton_status() -> dict:
    """What `status` says of Proton. A NetShield setting that cannot be read is said in `error` and does not fail the status."""
    try:
        return {"logged_in": proton_signed_in(), "netshield": netshield_pref(), "error": ""}
    except VpnError as exc:
        return {"logged_in": proton_signed_in(), "netshield": None, "error": str(exc)}


def keyring_session() -> Optional[proton.Session]:
    """The session the keyring holds now, None when there is none."""
    item = secrets.lookup_optional(secrets.PROTON_SESSION, secrets.PROTON_SESSION_ID)
    return None if item is None else proton.session_of_item(item)


def save_session(session: proton.Session) -> None:
    secrets.store(secrets.PROTON_SESSION, secrets.PROTON_SESSION_ID, proton.item_of_session(session))


def proton_account() -> proton.Account:
    """The account of the keyring's session. The caller holds the Proton lock: the session is read under it."""
    session = keyring_session()
    if session is None:
        raise VpnError("not signed in to Proton: run vekrona-vpn proton login")
    return proton.Account(session, keyring_session, save_session)


def proton_seed() -> bytes:
    return proton.seed_of_item(secrets.lookup(secrets.PROTON_KEY, secrets.PROTON_KEY_ID))


def read_catalog() -> Optional[dict]:
    return vpn.read_cache(proton_catalog_path(), proton.validate_catalog)


def recorded_certificate() -> Optional[dict]:
    """The certificate the catalog cache records. A cache that cannot be read records none: the refresh that follows writes it again."""
    try:
        catalog = read_catalog()
    except VpnError as exc:
        print(f"{PROG}: {exc}; the catalog is asked for again", file=sys.stderr)
        return None
    return None if catalog is None else catalog["certificate"]


def refresh_catalog(account: proton.Account) -> dict:
    """The account's plan and logical servers, asked of Proton and cached: `list` and `status` read the cache, and a connect uses it
    while it is young. A logical server that does not fit is said on stderr and left out. The certificate the cache records is kept."""
    max_tier, plan = proton.plan_of(account)
    catalog, left_out = proton.catalog_from_answers(plan, max_tier, proton.logicals_of(account))
    for reason in left_out:
        print(f"{PROG}: ignoring {reason}", file=sys.stderr)
    catalog["certificate"] = recorded_certificate()
    vpn.write_cache(proton_catalog_path(), catalog)
    return catalog


def fresh_catalog(account: proton.Account) -> dict:
    """The cached catalog while it is younger than CATALOG_MAX_AGE_SEC, else one asked of Proton (which needs the network)."""
    if not vpn.cache_is_stale(proton_catalog_path(), CATALOG_MAX_AGE_SEC):
        try:
            catalog = read_catalog()
        except VpnError as exc:
            print(f"{PROG}: {exc}; the catalog is asked for again", file=sys.stderr)
            catalog = None
        if catalog is not None:
            return catalog
    return refresh_catalog(account)


def issue_certificate(account: proton.Account, seed: bytes, netshield: int) -> proton.Certificate:
    """A certificate for the key, recorded in the catalog (its times only: the key is never kept there)."""
    cert = proton.certificate(account, seed, netshield)
    catalog = read_catalog()
    if catalog is None:
        raise VpnError("no catalog of the Proton account is kept: sign in again")
    catalog["certificate"] = {"refresh_time": cert.refresh_time, "expiration_time": cert.expiration_time, "netshield": netshield}
    vpn.write_cache(proton_catalog_path(), catalog)
    return cert


def forget_proton_here() -> None:
    """What signing out leaves on this machine: the renewal stops, the session and the seed leave the keyring, the catalog goes."""
    stop_renewal()
    secrets.clear(secrets.PROTON_SESSION, secrets.PROTON_SESSION_ID)
    secrets.clear(secrets.PROTON_KEY, secrets.PROTON_KEY_ID)
    vpn.remove_if_present(proton_catalog_path())


@contextlib.contextmanager
def proton_session_ended():
    """A Proton call that found its session ended: the sign-in is forgotten here too, so the bar offers Sign in again."""
    try:
        yield
    except proton.SessionEnded:
        forget_proton_here()
        raise


def sign_in_text(user_code: str) -> str:
    return "Enter code %s-%s at account.protonvpn.com/tv" % (user_code[:4], user_code[4:])


def login_path(uid: int) -> str:
    return os.path.join(vpn.user_dir(uid), LOGIN_NAME)


def write_login(uid: int, doc: dict) -> None:
    vpn.write_atomic(login_path(uid), json.dumps(doc), vpn.PRIVATE_FILE_MODE, directory_mode=vpn.PRIVATE_DIR_MODE)


def take_login(uid: int) -> dict:
    """The sign-in the foreground left for the unit (selector and notification id), removed as it is read."""
    path = login_path(uid)
    with vpn.files_reported("read " + path):
        with open(path) as handle:
            text = handle.read()
    vpn.remove_if_present(path)
    try:
        doc = json.loads(text)
    except vpn.JSON_ERRORS:
        raise VpnError("the sign-in request is not JSON")
    if not (isinstance(doc, dict) and isinstance(doc.get("selector"), str) and isinstance(doc.get("notification"), str)):
        raise VpnError("the sign-in request is in a layout this tool does not know")
    return doc


def notify_outcome(notification: str, text: str) -> None:
    """Replaces the sign-in's notification with `text`."""
    vpn.run(["notify-send", "--app-name=vekrona", "--replace-id=" + notification, "VPN", text])


def open_browser(url: str) -> None:
    """Starts the browser on `url` through a transient unit, and does not wait for it: xdg-open stays alive as long as the browser it
    started. systemd-run returns once the unit has started, so nothing is left to reap. A failure to start is an error."""
    try:
        vpn.run(["systemd-run", "--user", "--collect", "--quiet", "xdg-open", url])
    except VpnError as exc:
        raise VpnError("cannot start the browser: %s" % exc)


def close_notification(notification: str) -> None:
    """Closes the notification of a sign-in that did not start."""
    vpn.run(["busctl", "--user", "call", "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
             "org.freedesktop.Notifications", "CloseNotification", "u", notification])


def command_proton_login(args):
    """Starts a sign-in. The code is shown in a notification, the browser opens the page for it, and the code goes to stdout. A
    transient unit waits for the person to enter it (see command_proton_await), so this command returns at once. One sign-in waits at
    a time: a second is refused while the first is still waiting. When the sign-in cannot start, its notification is closed."""
    uid = os.getuid()
    with vpn.user_lock(uid):
        if vpn.execute(["systemctl", "--user", "is-active", "--quiet", PROTON_LOGIN_UNIT + ".service"]).returncode == 0:
            raise VpnError("a Proton sign-in is already waiting")
        selector, user_code = proton.start_fork()
        notification = vpn.run(["notify-send", "--print-id", "--app-name=vekrona", "--expire-time=0", "VPN",
                                sign_in_text(user_code)]).strip()
        try:
            open_browser(proton.SIGN_IN_URL)
            write_login(uid, {"selector": selector, "notification": notification})
            vpn.run(["systemd-run", "--user", "--collect", "--unit=" + PROTON_LOGIN_UNIT, *self_command("proton", "await")])
        except VpnError as exc:
            problems = [str(exc)]
            try:
                vpn.remove_if_present(login_path(uid))
                close_notification(notification)
            except VpnError as left:
                problems.append(str(left))
            raise VpnError("; ".join(problems)) from exc
    print(user_code)


def command_proton_await(args):
    """The transient unit of a sign-in: waits for the code, keeps the session and, when there is none yet, the seed, and the catalog,
    and replaces the notification with the outcome. When the catalog cannot be had, what this sign-in stored is cleared again. The
    selector only ever travels in the file the foreground wrote."""
    login = take_login(os.getuid())
    try:
        session = proton.await_session(login["selector"], now=time.monotonic, pause=time.sleep)
        created_seed = secrets.lookup_optional(secrets.PROTON_KEY, secrets.PROTON_KEY_ID) is None
        items = [(secrets.PROTON_SESSION, secrets.PROTON_SESSION_ID, proton.item_of_session(session))]
        if created_seed:
            items.append((secrets.PROTON_KEY, secrets.PROTON_KEY_ID, proton.item_of_seed(proton.new_seed())))
        secrets.store_all(items)
        try:
            catalog = refresh_catalog(proton.Account(session, keyring_session, save_session))
        except VpnError as exc:
            raise undo_sign_in(exc, created_seed)
    except VpnError as exc:
        try:
            notify_outcome(login["notification"], "Proton sign-in failed: %s" % exc)
        except VpnError as shown:
            raise VpnError("%s; and the notification could not show it: %s" % (exc, shown))
        raise
    notify_outcome(login["notification"], "Signed in to Proton (%s)" % catalog["plan"])


def undo_sign_in(exc: VpnError, created_seed: bool) -> VpnError:
    """The error for a sign-in whose catalog could not be had: the session it stored is cleared, and the seed too when this sign-in made it."""
    problems = [str(exc), "nothing of this sign-in was kept"]
    try:
        secrets.clear(secrets.PROTON_SESSION, secrets.PROTON_SESSION_ID)
        if created_seed:
            secrets.clear(secrets.PROTON_KEY, secrets.PROTON_KEY_ID)
    except VpnError as left:
        problems.append("and clearing it failed: %s" % left)
    return VpnError("; ".join(problems))


def command_proton_logout(args):
    """Forgets the Proton connections, ends the session with Proton and clears the keyring and the catalog here. A session that Proton
    cannot end is said after the rest is done: this machine is signed out either way. Holds the Proton lock: a renewal must not run
    with the session this removes."""
    with vpn.proton_lock(os.getuid()):
        session = keyring_session()
        for connection in vpn.nm_connections():
            if connection.vendor == vpn.VENDOR_PROTON:
                run_apply("forget", {"uuid": connection.uuid})
        failure = None
        if session is not None:
            try:
                proton.logout(proton.Account(session, keyring_session, save_session))
            except proton.SessionEnded:
                pass  # Proton has ended the session already: that is the state a logout asks for
            except VpnError as exc:
                failure = exc
        forget_proton_here()
    if failure is not None:
        raise VpnError("signed out on this machine, but Proton did not end the session: %s" % failure)


def read_settings() -> dict:
    """The preferences of vekrona-vpn (not secret): {"proton": {"netshield": 0|1|2}}; none when there is no file."""
    path = settings_path()
    try:
        with open(path) as handle:
            doc = json.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, *vpn.JSON_ERRORS) as exc:
        raise VpnError("cannot read %s: %s" % (path, exc))
    if not isinstance(doc, dict) or not isinstance(doc.get("proton", {}), dict):
        raise VpnError("%s is not a settings object" % path)
    return doc


def netshield_pref() -> int:
    level = read_settings().get("proton", {}).get("netshield", NETSHIELD_DEFAULT)
    if level not in proton.NETSHIELD_LEVELS:
        raise VpnError("the NetShield level in the settings is not one of %s" % ", ".join(map(str, proton.NETSHIELD_LEVELS)))
    return level


def command_proton_netshield(args):
    settings = read_settings()
    settings["proton"] = {**settings.get("proton", {}), "netshield": args.level}
    vpn.write_atomic(settings_path(), json.dumps(settings) + "\n", vpn.PRIVATE_FILE_MODE, directory_mode=vpn.PRIVATE_DIR_MODE)
    if proton_connection_active():
        print(f"{PROG}: reconnect to apply", file=sys.stderr)


def proton_connection_active() -> bool:
    return any(connection.vendor == vpn.VENDOR_PROTON and connection.is_active for connection in vpn.nm_connections())


def renewal_timers() -> List[str]:
    """The renewal timers there are (not the renewals that run: a running renewal may be the one that arms the next timer)."""
    text = vpn.run(["systemctl", "--user", "list-units", "--plain", "--no-legend", "--type=timer", RENEW_UNIT_PREFIX + "*"])
    return [line.split()[0] for line in text.splitlines() if line.strip()]


def stop_renewal() -> None:
    """Stops every renewal timer. A renewal that is running is not stopped: it may be the one arming the next timer."""
    for unit in renewal_timers():
        vpn.run(["systemctl", "--user", "stop", unit])


def schedule_renewal(at: int) -> None:
    """Replaces the renewal timers with one that fires at `at`, or RENEW_ARM_DELAY_SEC from now when `at` has passed. The unit is named
    after the time it fires, so the renewal that is running can arm the next one: a unit cannot replace itself."""
    stop_renewal()
    when = max(at, int(time.time()) + RENEW_ARM_DELAY_SEC)
    vpn.run(["systemd-run", "--user", "--collect", "--on-calendar=" + utc_text(when), "--unit=%s%d" % (RENEW_UNIT_PREFIX, when),
             *self_command("proton", "renew")])


def renewal_failed(exc: VpnError, expiry: int) -> None:
    """Tells the person that the certificate could not be renewed and when the tunnel stops working, and arms the one retry: RENEW_RETRY_SEC
    from now, or RENEW_EXPIRY_MARGIN_SEC before the expiry if that is sooner. After the expiry nothing is tried again."""
    now = time.time()
    notify = "Proton certificate could not be renewed: %s; the tunnel stops working at %s" % (
        exc, datetime.fromtimestamp(expiry).strftime("%H:%M"))
    vpn.run(["notify-send", "--app-name=vekrona", "VPN", notify])
    if now < expiry:
        retry = max(min(now + RENEW_RETRY_SEC, expiry - RENEW_EXPIRY_MARGIN_SEC), now + RENEW_ARM_DELAY_SEC)
        if retry < expiry:
            schedule_renewal(retry)


def command_proton_renew(args):
    """The renewal timer's command: while a Proton connection is up, a new certificate for the same key and NetShield level, recorded, and
    the next renewal at its RefreshTime. Otherwise nothing. A failure is said to the person, with one retry (see renewal_failed)."""
    if not proton_connection_active():
        return
    uid = os.getuid()
    expiry = recorded_expiry()
    try:
        with vpn.proton_lock(uid), proton_session_ended():
            cert = issue_certificate(proton_account(), proton_seed(), netshield_pref())
    except proton.SessionEnded:
        raise
    except VpnError as exc:
        renewal_failed(exc, expiry)
        raise
    schedule_renewal(cert.refresh_time)


def recorded_expiry() -> int:
    """The expiry of the certificate the connection in use was made with (the catalog records it)."""
    catalog = read_catalog()
    if catalog is None or catalog["certificate"] is None:
        raise VpnError("no certificate of the Proton connection is recorded")
    return catalog["certificate"]["expiration_time"]


def reusable_or_issued(account: proton.Account, catalog: dict, seed: bytes, netshield: int) -> proton.Certificate:
    """The recorded certificate while it is good for longer than CERTIFICATE_MIN_LEFT_SEC (no request to Proton), else a new one."""
    reused = proton.reusable_certificate(catalog, netshield, time.time())
    return reused if reused is not None else issue_certificate(account, seed, netshield)


def connect_proton(query: str) -> None:
    """Connects to the Proton server that `query` chooses (a country code, or free): the catalog (the cache while it is young), a certificate
    (the recorded one while it is good), and the helper's connect. The renewal is scheduled once the connection is handed over. When Proton
    cannot be reached (the kill switch blocks it) and a request to it is needed, that is said: turn the VPN off, then connect."""
    seal_pending()
    try:
        with vpn.proton_lock(os.getuid()), proton_session_ended():
            account = proton_account()
            seed = proton_seed()
            netshield = netshield_pref()
            catalog = fresh_catalog(account)
            choice = proton.choose(catalog, query)
            cert = reusable_or_issued(account, catalog, seed, netshield)
    except proton.Unreachable as exc:
        raise VpnError("Proton needs the network to issue a certificate: turn the VPN off, then connect") from exc
    ident = vpn.ConnectionId(vpn.VENDOR_PROTON, choice.country, vpn.PROTON_GENERATED_NAME)
    run_apply("connect", {"vendor": vpn.VENDOR_PROTON, "id": str(ident), "conf": proton.conf_text(choice.logical, choice.server, seed),
                          "private_key": proton.private_key_text(seed)})
    schedule_renewal(cert.refresh_time)



def parse_args(argv):
    parser = argparse.ArgumentParser(prog=PROG, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status").set_defaults(handler=command_status)
    commands.add_parser("list").set_defaults(handler=command_list)
    connect = commands.add_parser("connect")
    connect.add_argument("target")
    connect.add_argument("country", nargs="?")
    connect.set_defaults(handler=command_connect)
    commands.add_parser("off").set_defaults(handler=command_off)
    import_parser = commands.add_parser("import")
    import_parser.add_argument("--vendor", required=True, choices=vpn.IMPORT_VENDORS)
    import_parser.add_argument("files", nargs="*")
    import_parser.set_defaults(handler=command_import)
    forget = commands.add_parser("forget")
    forget.add_argument("uuid")
    forget.set_defaults(handler=command_forget)
    mullvad_parser = commands.add_parser("mullvad").add_subparsers(dest="mullvad_command", required=True)
    mullvad_parser.add_parser("login").set_defaults(handler=command_mullvad_login)
    mullvad_parser.add_parser("logout").set_defaults(handler=command_mullvad_logout)
    proton_parser = commands.add_parser("proton").add_subparsers(dest="proton_command", required=True)
    proton_parser.add_parser("login").set_defaults(handler=command_proton_login)
    proton_parser.add_parser("logout").set_defaults(handler=command_proton_logout)
    netshield = proton_parser.add_parser("netshield")
    netshield.add_argument("level", type=int, choices=proton.NETSHIELD_LEVELS)
    netshield.set_defaults(handler=command_proton_netshield)
    proton_parser.add_parser("renew").set_defaults(handler=command_proton_renew)
    # The unit of a sign-in runs this; it is not a command for a person.
    proton_parser.add_parser("await", help=argparse.SUPPRESS).set_defaults(handler=command_proton_await)
    commands.add_parser("seal").set_defaults(handler=command_seal)
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        args.handler(args)
    except VpnError as exc:
        # The shell shows stderr: a failure it started is its own to report.
        vekrona_cli.exit_unrecorded(PROG, str(exc))


if __name__ == "__main__":
    main()
