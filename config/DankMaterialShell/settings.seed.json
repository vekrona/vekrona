  "trayIconSpacing": 0,
  "barConfigs": [
    {
      "id": "default",
      "name": "Main Bar",
      "enabled": false,
      "position": 0,
      "screenPreferences": [
        "all"
      ],
      "showOnLastDisplay": true,
      "spacing": 8,
      "innerPadding": 0,
      "barInsetPadding": -1,
      "barLengthPadding": 0,
      "bottomGap": 0,
      "attachToScreenEdge": true,
      "transparency": 1.0,
      "widgetTransparency": 1.0,
      "squareCorners": true,
