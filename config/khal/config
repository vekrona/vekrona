[calendars]

[[vekrona]]
path = ~/.local/share/vekrona-calendars/*
type = discover

[[vekrona_collections]]
path = ~/.local/share/vekrona-calendars/*/*
type = discover

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M
firstweekday = 0
