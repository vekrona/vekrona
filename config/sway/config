set $hyper Mod4+Ctrl+Mod1
set $term ghostty

include /etc/sway/config.d/*.conf
include /usr/share/sway-systemd/95-xdg-desktop-autostart.conf
include ~/.config/sway/config.d/*.conf

output DP-7 mode 3840x2160@240Hz adaptive_sync on scale 1.5

input "type:keyboard" {
    xkb_layout us,ua
    xkb_options grp:alts_toggle,shift:both_capslock_cancel
    repeat_delay 250
    repeat_rate 40
    xkb_numlock enabled
}

input "type:pointer" {
    accel_profile flat
    pointer_accel -0.7
}

floating_modifier Mod4 normal
default_border pixel 2
gaps inner 6
smart_gaps on
focus_follows_mouse yes

bindsym $hyper+Return exec $term
bindsym $hyper+Space exec dms ipc call spotlight toggle
bindsym --to-code $hyper+v exec dms ipc call clipboard toggle
bindsym --to-code $hyper+n exec dms ipc call notifications toggle
bindsym $hyper+comma exec dms ipc call control-center toggle
bindsym $hyper+Escape exec dms ipc call lock lock
bindsym $hyper+BackSpace exec dms ipc call powermenu toggle

bindsym $hyper+1 workspace number 1
bindsym $hyper+2 workspace number 2
bindsym $hyper+3 workspace number 3
bindsym $hyper+4 workspace number 4
bindsym $hyper+5 workspace number 5
bindsym $hyper+6 workspace number 6
bindsym $hyper+7 workspace number 7
bindsym $hyper+8 workspace number 8
bindsym $hyper+9 workspace number 9

bindsym $hyper+Shift+1 move container to workspace number 1
bindsym $hyper+Shift+2 move container to workspace number 2
bindsym $hyper+Shift+3 move container to workspace number 3
bindsym $hyper+Shift+4 move container to workspace number 4
bindsym $hyper+Shift+5 move container to workspace number 5
bindsym $hyper+Shift+6 move container to workspace number 6
bindsym $hyper+Shift+7 move container to workspace number 7
bindsym $hyper+Shift+8 move container to workspace number 8
bindsym $hyper+Shift+9 move container to workspace number 9

bindsym --to-code $hyper+h focus left
bindsym --to-code $hyper+j focus down
bindsym --to-code $hyper+k focus up
bindsym --to-code $hyper+l focus right
bindsym $hyper+Left focus left
bindsym $hyper+Down focus down
bindsym $hyper+Up focus up
bindsym $hyper+Right focus right

bindsym --to-code $hyper+Shift+h move left
bindsym --to-code $hyper+Shift+j move down
bindsym --to-code $hyper+Shift+k move up
bindsym --to-code $hyper+Shift+l move right
bindsym $hyper+Shift+Left move left
bindsym $hyper+Shift+Down move down
bindsym $hyper+Shift+Up move up
bindsym $hyper+Shift+Right move right

bindsym --to-code $hyper+r mode "resize"
bindsym --to-code $hyper+f fullscreen toggle
bindsym --to-code $hyper+w kill
bindsym --to-code $hyper+t floating toggle
bindsym --to-code $hyper+e layout toggle split

bindsym $hyper+Print exec vekrona-screenshot
bindsym $hyper+Shift+Print exec vekrona-record
bindsym --to-code $hyper+Shift+c exec vekrona-caffeine
bindsym --to-code $hyper+Shift+n exec dms ipc call night toggle
bindsym --to-code $hyper+Shift+t exec vekrona-theme next

bindsym XF86AudioRaiseVolume exec dms ipc call audio increment 5
bindsym XF86AudioLowerVolume exec dms ipc call audio decrement 5
bindsym XF86AudioMute exec dms ipc call audio mute
bindsym XF86MonBrightnessUp exec dms ipc call brightness increment 5
bindsym XF86MonBrightnessDown exec dms ipc call brightness decrement 5

mode "resize" {
    bindsym --to-code h resize shrink width 10px
    bindsym --to-code j resize grow height 10px
    bindsym --to-code k resize shrink height 10px
    bindsym --to-code l resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

for_window [class="^[Ss]team$"] floating enable
