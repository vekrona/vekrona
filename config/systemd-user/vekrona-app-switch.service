[Unit]
Description=Cmd+Tab app switcher overlay
PartOf=sway-session.target
After=sway-session.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/qs -c vekrona-app-switch
# A stop, restart or crash while the switcher is open would leave Sway in its appswitch mode. The "-" is for the stop at logout,
# when Sway is already gone and swaymsg has nothing to talk to.
ExecStopPost=-/usr/bin/swaymsg mode default
Restart=on-failure
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=sway-session.target
