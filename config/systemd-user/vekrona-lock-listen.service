[Unit]
Description=Lock the screen when logind asks sway's session to lock
PartOf=sway-session.target
After=sway-session.target
# The lock on logind's request is never given up on (the delay grows from 1 s to 60 s).
StartLimitIntervalSec=0

[Service]
ExecStart=%h/.local/bin/vekrona-lock listen
Restart=on-failure
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=sway-session.target
