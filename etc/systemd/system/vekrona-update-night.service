[Unit]
Description=Install updates at midnight
# A reboot into dnf's offline transaction on battery could drain it mid-transaction and cuts short whatever the laptop was
# used for; a laptop that is not plugged in skips the night and tries the next one.
ConditionACPower=true

[Service]
Type=oneshot
Environment=HOME=/root
# network-online.target stays reached across a suspend, so a wake from sleep waits for the connection itself.
ExecStartPre=/usr/bin/nm-online --quiet --timeout=60
ExecStart=/usr/local/lib/vekrona/libexec/vekrona-update-night
