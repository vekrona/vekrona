[Unit]
Description=Install updates at midnight

[Service]
Type=oneshot
Environment=HOME=/root
# network-online.target stays reached across a suspend, so a wake from sleep waits for the connection itself.
ExecStartPre=/usr/bin/nm-online --quiet --timeout=60
ExecStart=/usr/local/lib/vekrona/libexec/vekrona-update-night
