[Unit]
Description=Report the result of the offline update
ConditionPathExists=/var/lib/vekrona/offline-pending
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/local/lib/vekrona/libexec/vekrona-update-post

[Install]
WantedBy=multi-user.target
