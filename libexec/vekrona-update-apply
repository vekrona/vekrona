#!/usr/bin/env bash
# Installs updates as root, under the update lock. Started by the vekrona-update-{now,reboot,poweroff} units and by
# vekrona-update-night.
#   --online                 dnf and Flatpak run now
#   --offline [--poweroff]   Flatpak runs now; dnf's transaction is stored and runs in the next boot's
#                            system-update.target, after which the machine reboots (or powers off with --poweroff)
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$ROOT/lib/common.sh"
source "$ROOT/lib/update.sh"

usage() {
  echo "usage: vekrona-update-apply --online | --offline [--poweroff]" >&2
  exit 2
}

mode="" poweroff=""
case "${1:-}" in
  --online) [[ $# -eq 1 ]] || usage; mode=online ;;
  --offline)
    mode=offline
    case "${2:-}" in
      "") ;;
      --poweroff) [[ $# -eq 2 ]] || usage; poweroff=--poweroff ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac

require_root
update_lock

pre_number=""
post_number=""
post_attempted=0

create_post_snapshot() {
  post_attempted=1
  post_number="$(snapper -c root create -p -c number -d "vekrona-update post" --pre-number "$pre_number")" || return 1
  [[ -n "$post_number" ]]
}

on_exit() {
  local status=$?
  if [[ -n "$pre_number" && $post_attempted -eq 0 ]]; then
    create_post_snapshot \
      || warn "failed to create post-update snapshot; pre-update snapshot $pre_number has no matching post snapshot"
  fi
  [[ -n "$post_number" ]] && log "post-update snapshot: $post_number"
  [[ -n "$pre_number" ]] && log "roll back with: vekrona-rollback $pre_number"
  exit "$status"
}
trap on_exit EXIT

update_flatpak() {
  log "=== flatpak update ==="
  flatpak update --system -y --noninteractive
}

update_online() {
  log "=== dnf upgrade ==="
  dnf5 upgrade --refresh -y
  update_postflight
  update_flatpak
  update_promote_newest_kernel
}

# Sets stored=1 when dnf has a transaction waiting for the offline boot.
update_offline() {
  local status=0
  update_flatpak

  log "=== dnf upgrade: storing the offline transaction ==="
  dnf5 check-upgrade --refresh >/dev/null || status=$?
  case "$status" in
    0) log "dnf has nothing to install, so there is nothing to reboot for" ;;
    100)
      dnf5 upgrade --offline -y
      # check-upgrade also lists updates dnf skips (a repository that lags behind another leaves packages whose
      # dependencies do not match), and then dnf stores nothing.
      if dnf5 offline status | grep -q 'An offline transaction was initiated'; then
        stored=1
      else
        log "dnf could install none of the listed updates, so there is nothing to reboot for"
      fi
      ;;
    *) die "dnf5 check-upgrade failed with exit status $status" ;;
  esac
}

stored=0
update_stage_proton

pre_number="$(snapper -c root create -p -c number -d "vekrona-update pre")"
[[ -n "$pre_number" ]] || die "failed to create pre-update snapshot"
log "pre-update snapshot: $pre_number"

"update_$mode"

if [[ $stored -eq 1 ]]; then
  # dnf runs the stored transaction in the next boot, so the changes this snapshot pair is meant to bracket have not
  # happened yet: the marker hands the pre snapshot to vekrona-update-post, which closes the pair after them.
  post_attempted=1
  { date -Iseconds; echo "$OFFLINE_MARKER_PRE_KEY$pre_number"; } >"$VEKRONA_OFFLINE_MARKER"
  log "post-update snapshot: taken by vekrona-update-post after the offline transaction"
  log "=== rebooting into the offline update${poweroff:+, then powering off} ==="
  if ! dnf5 offline reboot -y ${poweroff:+"$poweroff"}; then
    rm -f "$VEKRONA_OFFLINE_MARKER"
    post_attempted=0 # nothing was applied: close the pair now, as on every other failure
    die "dnf5 offline reboot failed"
  fi
else
  create_post_snapshot || die "failed to create post-update snapshot; pre-update snapshot $pre_number has no matching post snapshot"
  update_check
  log "done: system updated"
fi
