#!/usr/bin/python3 -I
"""The root side of vekrona-vpn: every change to NetworkManager's WireGuard connections and to the kill switch.

  apply INSTANCE      one operation of a user, from vekrona-vpn-apply@INSTANCE.service. INSTANCE is "<op>-<uid>": the op is one
                      of a closed set (import, login, connect, off, forget, seal) and the uid is the user whose request file
                      /run/user/<uid>/vekrona-vpn/request.json holds the arguments, which are checked again here.

This helper never talks to the keyring: the keys of a connection come in the request (the user's tmpfs file, for one operation)
and go to nmcli on stdin. Only `seal` hands keys out, to the user, in a file of the user's runtime directory that the user removes.

Every operation runs under one lock (/run/vekrona-vpn/lock), the kill switch's loading and removal included: connect loads the
table itself, so an off cannot land between its arming and the tunnel coming up, and a tunnel never comes up unprotected. There
is no unit for the kill switch: the table lives in the kernel, and off removes it.

The user may start these units (etc/polkit-1/rules.d/50-vekrona-vpn.rules), so nothing that arrives is trusted: the instance
name must match exactly, the request must be a small regular file of that user, every configuration is parsed and rendered anew
(nothing of the user's file but its checked fields reaches NetworkManager), and no error repeats what a file held.

Every request holds a nonce of the client's making. After an operation ended the helper records that nonce in
/run/vekrona-vpn/served/<uid>, with the line it failed with when it failed, and the client reads it: a start that merged into the
job of an interrupted call returns success though this helper never read the client's request, and the receipt is what tells the
two apart. The failure line is also how the client learns why: it does not read the journal.

Publishes /run/vekrona-vpn/state.json for the shell: {"schema":1,"armed":bool,"uuid":str|null}."""
import os
import sys
from typing import List, Optional, Tuple

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import vekrona_countries
import vekrona_vpn as vpn
from vekrona_vpn import VpnError

PROG = "vekrona-vpn-apply"
EXIT_USAGE = 64


# ---- The kill switch ----------------------------------------------------------------------------------------------------

def publish(state: vpn.State) -> None:
    vpn.write_atomic(vpn.run_path("state.json"), vpn.state_text(state), vpn.PUBLIC_FILE_MODE)


def transition(new: vpn.State, table: str) -> None:
    """Publish `new`, then load the nft `table` text. The state goes first so that it is never behind the table: a publish that
    fails leaves both where they were, and an nft change that fails after it gets the previous state published again before the
    error is raised, so state.json never says something the table does not do. A previous state nobody can read counts as armed
    for no connection: the bar then keeps offering Off."""
    try:
        previous = vpn.read_state()
    except VpnError:
        previous = vpn.State(True, None)
    publish(new)
    try:
        vpn.run(["nft", "-f", "-"], input_text=table)
    except VpnError as exc:
        try:
            publish(previous)
        except VpnError as republish:
            raise VpnError("%s; and the previous state could not be published again: %s" % (exc, republish))
        raise


def arm(uuid: str, endpoint: vpn.Endpoint) -> None:
    """Load the kill switch table (swapping a loaded one in one nft transaction, so there is no instant with nothing blocked). It
    lets the handshake reach `endpoint` and the uid of tor when tor exists, and the state names the connection `uuid`."""
    transition(vpn.State(True, uuid), vpn.render_killswitch(endpoint, vpn.lookup_tor_uid()))


def disarm() -> None:
    transition(vpn.DISARMED, vpn.render_disarm())


# ---- Connections --------------------------------------------------------------------------------------------------------

def remove_import_file(path: str) -> None:
    with vpn.files_reported("remove " + path):
        os.unlink(path)


def import_conf(conf: vpn.WgConf, ident: vpn.ConnectionId, made: List[str]) -> str:
    """Make a NetworkManager connection of `conf` under the id `ident` and return its uuid. The configuration passes through a file
    that only root can enter and that exists only for the import. A profile that an earlier import left unfinished (the helper was
    killed between the import and the change that names it) is deleted first: it holds a placeholder key and would autoconnect.
    `made` gets the uuid as soon as NetworkManager has the connection, so that the caller can delete it when a later step fails."""
    for leftover in vpn.nm_unfinished_imports():
        vpn.nm_delete(leftover)
    directory = vpn.run_path("import")
    path = os.path.join(directory, vpn.CONF_FILE_NAME)
    with vpn.files_reported("write " + path):
        os.makedirs(directory, mode=vpn.PRIVATE_DIR_MODE, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, vpn.PRIVATE_FILE_MODE)
    try:
        with vpn.files_reported("write " + path), os.fdopen(fd, "w") as handle:
            os.fchmod(handle.fileno(), vpn.PRIVATE_FILE_MODE)
            handle.write(vpn.render_import_conf(conf))
        uuid = vpn.nm_import(path)
        made.append(uuid)
    except BaseException as exc:
        try:
            remove_import_file(path)
        except VpnError as left:
            raise VpnError("%s; and %s" % (exc, left))
        raise
    remove_import_file(path)
    try:
        vpn.nm_modify(uuid, vpn.nm_settings_for(conf, str(ident)))
    except VpnError as exc:
        try:
            vpn.nm_delete(uuid)
        except VpnError as cleanup:
            raise VpnError("%s; and the half-made connection %s could not be removed: %s" % (exc, uuid, cleanup))
        made.remove(uuid)
        raise
    # NetworkManager may have autoconnected the profile before the modify. It had no routes, but a tunnel that is up and not
    # chosen would show as the connection in use.
    if any(connection.uuid == uuid and connection.is_active for connection in vpn.nm_connections()):
        vpn.nm_down(uuid)
    return uuid


def delete_all(connections: List[vpn.Connection]) -> None:
    for connection in connections:
        vpn.nm_delete(connection.uuid)


def request_relay(doc: object) -> vpn.Relay:
    try:
        return vpn.validate_relay(doc)
    except VpnError as exc:
        raise VpnError("the request holds no usable relay: %s" % exc)


def request_device(doc: object) -> vpn.Device:
    try:
        return vpn.validate_device(doc)
    except VpnError as exc:
        raise VpnError("the request holds no usable device: %s" % exc)


def undo_made(made: List[str], exc: VpnError) -> VpnError:
    """The error for an operation that failed with `exc` after it made connections: they are deleted again, so that no connection is
    left without its key. A deletion that fails is said in the error too."""
    problems = []
    for uuid in made:
        try:
            vpn.nm_delete(uuid)
        except VpnError as cleanup:
            problems.append("%s: %s" % (uuid, cleanup))
    return exc if not problems else VpnError("%s; and these connections could not be removed: %s" % (exc, "; ".join(problems)))


def op_import(request: dict) -> None:
    vendor, files = request.get("vendor"), request.get("files")
    if vendor not in vpn.IMPORT_VENDORS:
        raise VpnError("not a vendor to import for")
    if not isinstance(files, list) or not 0 < len(files) <= vpn.MAX_FILES:
        raise VpnError("the request needs 1 to %d files" % vpn.MAX_FILES)
    checked = []
    for position, entry in enumerate(files, 1):
        with vpn.labelled("file %d" % position):
            if not isinstance(entry, dict) or not isinstance(entry.get("file"), str) or not isinstance(entry.get("text"), str):
                raise VpnError("not a file entry")
            _, conf = vpn.check_conf(vpn.encode_conf(entry["text"]))
        checked.append((conf, vpn.import_id(vendor, entry["file"])))
    vpn.require_distinct_ids([(ident, entry["file"]) for (_, ident), entry in zip(checked, files)])
    made: List[str] = []
    replaced: List[vpn.Connection] = []
    for done, (conf, ident) in enumerate(checked):
        replaced += [connection for connection in vpn.nm_connections() if connection.full_id == str(ident)]
        try:
            import_conf(conf, ident, made)
        except VpnError as exc:
            # The files are checked before the first is imported, so what fails here is NetworkManager: say how far it got, and
            # delete what this import made, so that no connection is left without its key.
            raise undo_made(made, VpnError("file %d: %s (%d of %d files were imported before it)" % (done + 1, exc, done, len(checked))))
    try:
        delete_all(replaced)
    except VpnError as exc:
        raise undo_made(made, exc)


def op_login(request: dict) -> None:
    device = request_device(request.get("device"))
    relay = request_relay(request.get("relay"))
    older = [connection for connection in vpn.nm_connections() if connection.vendor == vpn.VENDOR_MULLVAD]
    made: List[str] = []
    try:
        import_conf(vpn.mullvad_conf(device, relay), vpn.ConnectionId(vpn.VENDOR_MULLVAD, relay.country.upper(), relay.hostname), made)
        delete_all(older)
    except VpnError as exc:
        raise undo_made(made, exc)


def request_conf(text: object) -> vpn.WgConf:
    if not isinstance(text, str):
        raise VpnError("the request holds no configuration")
    _, conf = vpn.check_conf(vpn.encode_conf(text))
    return conf


def request_proton_id(value: object) -> vpn.ConnectionId:
    """The connection id of a generated Proton connection: vekrona-vpn/proton/<country or FREE>/signed-in, spelled as it is made."""
    if not isinstance(value, str):
        raise VpnError("the request holds no connection id")
    ident = vpn.parse_connection_id(value)
    if (ident.vendor != vpn.VENDOR_PROTON or str(ident) != value or ident.country == vekrona_countries.UNKNOWN_COUNTRY
            or ident.name != vpn.PROTON_GENERATED_NAME):
        raise VpnError("the request holds no usable Proton connection id")
    return ident


def provider_connection(request: dict) -> Tuple[vpn.WgConf, vpn.ConnectionId, dict]:
    """(configuration, connection id, keys) of a new connection of the request. The vendor is looked at once, here: each vendor's
    request is checked as the vendor's own answer, and what comes out is one shape for every path below. A Mullvad request carries
    the relay and the device and the configuration is made here; a Proton request carries the configuration itself (its address and
    peer), its connection id and the private key, which must be the configuration's."""
    vendor = request.get("vendor")
    if vendor == vpn.VENDOR_MULLVAD:
        relay = request_relay(request.get("relay"))
        device = request_device(request.get("device"))
        return (vpn.mullvad_conf(device, relay), vpn.ConnectionId(vpn.VENDOR_MULLVAD, relay.country.upper(), relay.hostname),
                {"private_key": device.private_key})
    if vendor == vpn.VENDOR_PROTON:
        conf = request_conf(request.get("conf"))
        if conf.preshared_key is not None:
            # Proton's configurations carry no preshared key: one here is not what this connect was made for.
            raise VpnError("a Proton configuration holds a preshared key, which Proton does not issue")
        keys = vpn.validate_keys({"private_key": request.get("private_key")})
        if keys["private_key"] != conf.private_key:
            raise VpnError("the private key is not the one of the configuration")
        return conf, request_proton_id(request.get("id")), keys
    raise VpnError("not a vendor that connects")


def replaced_by(ident: vpn.ConnectionId, connection: vpn.Connection) -> bool:
    """Whether a new connection under `ident` replaces `connection`: every generated Proton connection, whatever its country (an import
    before WP3 is never one of them), and for the other vendors the connections of the same vendor and country."""
    if ident.vendor == vpn.VENDOR_PROTON:
        return connection.vendor == vpn.VENDOR_PROTON and connection.name == vpn.PROTON_GENERATED_NAME
    return connection.vendor == ident.vendor and connection.country == ident.country


def connection_for(conf: vpn.WgConf, ident: vpn.ConnectionId, made: List[str]) -> Tuple[str, List[vpn.Connection]]:
    """(uuid, the connections to delete once it is in use) for a new connection of `conf` under `ident`. Those are the connections it
    replaces (see replaced_by). They are deleted only after the new one exists, so that its key is never in fewer places than one.
    `made` gets the new uuid (see import_conf)."""
    older = [connection for connection in vpn.nm_connections() if replaced_by(ident, connection)]
    uuid = import_conf(conf, ident, made)
    return uuid, older


def op_connect(request: dict) -> None:
    """Arm the kill switch for the connection's endpoint, then bring the connection up with the keys of the request. Arming comes
    first, and a failure after it leaves traffic blocked: the person tries again or turns the VPN off."""
    delete_after: List[vpn.Connection] = []
    if "uuid" in request:
        uuid = vpn.require_uuid(request["uuid"])
        connections = {connection.uuid: connection for connection in vpn.nm_connections()}
        if uuid not in connections:
            raise VpnError("not a connection of vekrona-vpn")
        keys = vpn.validate_keys(request.get("keys"))
        vpn.require_bound_to_tunnel(uuid, connections[uuid].full_id)
    else:
        conf, ident, keys = provider_connection(request)
        made: List[str] = []
        try:
            uuid, delete_after = connection_for(conf, ident, made)
        except VpnError as exc:
            raise undo_made(made, exc)
    arm(uuid, vpn.nm_endpoint(uuid))
    for connection in vpn.nm_connections():
        if connection.is_active and connection.uuid != uuid:
            vpn.nm_down(connection.uuid)
    vpn.require_kill_switch()
    vpn.nm_up(uuid, keys["private_key"])
    if "preshared_key" in keys:
        try:
            vpn.wg_set_preshared(uuid, keys["preshared_key"])
        except VpnError as exc:
            # A tunnel without its preshared key carries nothing: it goes down, and the kill switch stays armed.
            try:
                vpn.nm_down(uuid)
            except VpnError as down:
                raise VpnError("the preshared key of the peer could not be set (%s), and the tunnel could not be taken down: %s" % (exc, down))
            raise VpnError("the preshared key of the peer could not be set, so the tunnel is down and the kill switch stays armed (%s)" % exc)
    delete_all([connection for connection in delete_after if connection.uuid != uuid])


def sealed_entry(connection: vpn.Connection) -> Optional[dict]:
    """The keys of a connection whose keyfile holds its private key, for the user to store; None when its key is sealed already."""
    flags, private_key, peers, ipv4, ipv6 = vpn.nm_get(
        connection.uuid, ["wireguard.private-key-flags", "wireguard.private-key", "wireguard.peers", "ipv4.addresses", "ipv6.addresses"],
        secrets=True)
    if not vpn.key_in_keyfile(vpn.key_flags_of(flags)):
        return None
    entry = {"uuid": connection.uuid, "id": connection.full_id, "vendor": connection.vendor, "private_key": private_key,
             "ipv4_address": ipv4.split(",")[0].strip(), "ipv6_address": ipv6.split(",")[0].strip()}
    preshared = vpn.preshared_key_in(peers)
    if preshared is not None:
        entry["preshared_key"] = preshared
    return entry


def op_seal(uid: int, request: dict) -> None:
    """`export`: the keys of every connection whose keyfile still holds one go to the user, in sealed.json. `strip`: the connections
    named by the request lose their keys from NetworkManager, and their keyfiles are checked to hold none."""
    phase = request.get("phase")
    if phase == "export":
        entries = [entry for entry in (sealed_entry(connection) for connection in vpn.nm_connections()) if entry is not None]
        vpn.write_sealed(uid, entries)
    elif phase == "strip":
        uuids = request.get("uuids")
        if not isinstance(uuids, list) or not all(vpn.is_uuid(uuid) for uuid in uuids):
            raise VpnError("the request holds no list of connection uuids")
        known = {connection.uuid for connection in vpn.nm_connections()}
        for uuid in uuids:
            if uuid not in known:
                raise VpnError("not a connection of vekrona-vpn")
            vpn.nm_modify(uuid, vpn.nm_seal_settings(uuid))
        for uuid in uuids:
            vpn.require_keyfile_without_secrets(uuid)
    else:
        raise VpnError("seal has no phase of that name")


def op_off(request: dict) -> None:
    """Take the tunnel down, then remove the kill switch. A tunnel that cannot be taken down leaves the kill switch where it is."""
    for connection in vpn.nm_connections():
        if connection.is_active:
            vpn.nm_down(connection.uuid)
    disarm()


def op_forget(request: dict) -> None:
    uuid = vpn.require_uuid(request.get("uuid"))
    for connection in vpn.nm_connections():
        if connection.uuid == uuid:
            if connection.is_active:
                vpn.nm_down(uuid)
            vpn.nm_delete(uuid)
            return
    raise VpnError("not a connection of vekrona-vpn")


OPERATIONS = {"import": op_import, "login": op_login, "connect": op_connect, "off": op_off, "forget": op_forget}


def run_operation(op: str, uid: int, request: dict) -> None:
    """Only `seal` writes into the user's runtime directory, so only it is given the user's uid."""
    if op == "seal":
        op_seal(uid, request)
    else:
        OPERATIONS[op](request)


def apply(instance: str) -> None:
    op, uid = vpn.parse_instance(instance)
    with vpn.exclusive_lock(vpn.RUN_DIR, vpn.PUBLIC_DIR_MODE):
        # An export of `seal` that nothing took back (its client died) does not outlive the next operation of its user.
        vpn.remove_sealed(uid)
        request = vpn.read_request(uid)
        nonce = vpn.require_nonce(request.get("nonce"))
        try:
            run_operation(op, uid, request)
        except VpnError as exc:
            try:
                vpn.record_receipt(uid, vpn.Receipt(nonce, str(exc)))
            except VpnError as unrecorded:
                raise VpnError("%s; and its receipt could not be written: %s" % (exc, unrecorded))
            raise
        vpn.record_receipt(uid, vpn.Receipt(nonce, None))


def main(argv: List[str]) -> int:
    if os.geteuid() != 0:
        print("%s: needs root" % PROG, file=sys.stderr)
        return 1
    try:
        if len(argv) == 3 and argv[1] == "apply":
            apply(argv[2])
        else:
            print("usage: %s apply INSTANCE" % PROG, file=sys.stderr)
            return EXIT_USAGE
    except VpnError as exc:
        print("%s: %s" % (PROG, exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
