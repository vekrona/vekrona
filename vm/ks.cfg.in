text
lang en_US.UTF-8
keyboard us
timezone UTC --utc
firewall --disabled
selinux --enforcing

zerombr
clearpart --all --initlabel
autopart --type=btrfs
bootloader --location=mbr

network --bootproto=dhcp --hostname=@VM_NAME@

rootpw --lock
user --name=vekrona --password=vekrona --plaintext --groups=wheel
sshkey --username=vekrona "@HARNESS_PUBKEY@"

shutdown

%packages
@core
rsync
qemu-guest-agent
%end

%post
cat > /etc/sudoers.d/vekrona <<'EOF'
vekrona ALL=(ALL) NOPASSWD: ALL
Defaults:vekrona !authenticate
EOF
chmod 0440 /etc/sudoers.d/vekrona
install -d /etc/systemd/sleep.conf.d
cat > /etc/systemd/sleep.conf.d/virtio-gpu-cannot-resume.conf <<'EOF'
[Sleep]
AllowSuspend=no
AllowHibernation=no
AllowHybridSleep=no
AllowSuspendThenHibernate=no
EOF
systemctl enable sshd
install -d -m 0700 -o vekrona -g vekrona /home/vekrona/.ssh
cat >> /home/vekrona/.ssh/authorized_keys <<'EOF'
@SSH_PUBKEY@
EOF
chown vekrona:vekrona /home/vekrona/.ssh/authorized_keys
chmod 0600 /home/vekrona/.ssh/authorized_keys
%end
