text
lang en_US.UTF-8
keyboard us
timezone UTC --utc
firewall --disabled
selinux --enforcing

zerombr
clearpart --all --initlabel
autopart --type=btrfs
bootloader --location=mbr

network --bootproto=dhcp --hostname=vekrona-test

rootpw --lock
user --name=vekrona --password=vekrona --plaintext --groups=wheel
sshkey --username=vekrona "@SSH_PUBKEY@"

shutdown

%packages
@core
git
openssh-server
rsync
python3
inotify-tools
%end

%post
echo 'vekrona ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/vekrona
chmod 0440 /etc/sudoers.d/vekrona
systemctl enable sshd
%end
